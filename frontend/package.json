{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:docker": "docker build -f Dockerfile.e2e -t fulkro-e2e . && docker run --rm fulkro-e2e",
    "test:polish": "playwright test --config=playwright.polish.config.ts",
    "test:polish:ui": "playwright test --config=playwright.polish.config.ts --ui",
    "test:polish:p1": "playwright test --config=playwright.polish.config.ts tests/polish/p1",
    "test:polish:p2": "playwright test --config=playwright.polish.config.ts tests/polish/p2",
    "test:polish:p3": "playwright test --config=playwright.polish.config.ts tests/polish/p3",
    "test:polish:probe": "playwright test --config=playwright.polish.config.ts tests/polish/probe",
    "test:polish:cliente": "playwright test --config=playwright.polish.config.ts tests/polish/cliente",
    "test:polish:green": "playwright test --config=playwright.polish.config.ts tests/polish/probe tests/polish/p1 tests/polish/p2 tests/polish/p3 tests/polish/cliente",
    "test:polish:report": "playwright show-report polish-report"
  },
