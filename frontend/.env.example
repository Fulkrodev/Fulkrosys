# Backend FastAPI base URL used by the Next.js rewrites proxy (/api/* → this).
FULKRO_BACKEND_URL=http://localhost:8000

# Auth Ed25519 PUBLIC KEY (FASE 3.C middleware role-based)
# Pareja del backend FULKRO_AUTH_PRIVATE_KEY. Verifica JWT session
# server-side en middleware.ts via jose.importSPKI con algoritmo EdDSA.
# Derivar con: openssl pkey -in priv.pem -pubout
# Multi-line PEM con quotes dobles funciona via Next.js @next/env.
# Server-side only — NO usar prefix NEXT_PUBLIC_ (expondría al browser).
# FULKRO_AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# <salida openssl pkey -in priv.pem -pubout>
# -----END PUBLIC KEY-----"
