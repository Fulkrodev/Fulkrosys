# FULKRO — Caddy reverse proxy · PRODUCCIÓN
# Topología (2026-06-10):
#   fulkro.es, www.fulkro.es  →  LANDING estático (14 páginas · /srv/landing)
#   app.fulkro.es             →  PLATAFORMA (Next.js frontend + FastAPI /api/*)
# TLS auto (Let's Encrypt) + HSTS + límite de body + headers de seguridad.
#
# NOTA rate_limit (DESACTIVADO · EXTRA1): `rate_limit` NO es nativo de Caddy v2 ·
# requiere imagen custom (xcaddy --with github.com/mholt/caddy-ratelimit). La
# imagen caddy:2 estándar (la del docker-compose.prod.yml) NO lo trae → con el
# bloque activo, `caddy validate`/runtime FALLAN. Queda comentado; la app conserva
# BodySizeLimitMiddleware + cap LLM + límites Celery como defensa en profundidad.

{
    email admin@fulkro.es
    # auto_https ON (default) · Let's Encrypt para los dominios de abajo
    servers {
        protocols h1 h2 h3
    }
    # order rate_limit before basicauth   # ← requiere imagen custom (ver cabecera)
}

# ════════════════════════════════════════════════════════════════════════════
# LANDING · sitio comercial estático (dominio raíz + www)
# ════════════════════════════════════════════════════════════════════════════
fulkro.es, www.fulkro.es {
    encode zstd gzip

    root * /srv/landing
    file_server

    # Headers de seguridad + HSTS (2 años · includeSubDomains · preload)
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
        -Server
        -X-Powered-By
    }

    log {
        output file /var/log/caddy/landing.access.log {
            roll_size 50MB
            roll_keep 10
        }
        format json
    }
}

# ════════════════════════════════════════════════════════════════════════════
# PLATAFORMA · el sistema entero (admin + cliente + auditor como rutas)
# ════════════════════════════════════════════════════════════════════════════
app.fulkro.es {
    encode zstd gzip

    # Límite de tamaño de cuerpo en el borde (complementa BodySizeLimitMiddleware app)
    request_body {
        max_size 100MB
    }

    # Rate-limit de borde · DESACTIVADO (requiere módulo caddy-ratelimit · ver
    # cabecera). Para activar: imagen custom xcaddy + descomentar este bloque.
    # rate_limit {
    #     zone fulkro_global {
    #         key {remote_host}
    #         events 120
    #         window 1m
    #     }
    # }

    # ── Routing backend vs frontend ──────────────────────────────────────────
    # En prod el backend (FastAPI/uvicorn · alias de red `app`) sólo sirve `/api/*`
    # (/docs · /redoc · /openapi.json deshabilitados en prod · ver main.py
    # _prod_docs_off). Todo lo demás lo sirve el frontend Next.js (frontend:3000).

    # API → backend directo (sin pasar por el rewrite de Next).
    handle /api/* {
        # SSE necesita streaming sin buffer + timeouts largos (EventSource del
        # portal). Las rutas SSE viven todas bajo /api/v1/* → matcher anidado.
        @sse path /api/v1/*/stream* /api/v1/sse/* /api/v1/*/events*
        reverse_proxy @sse app:8000 {
            flush_interval -1
            transport http {
                response_header_timeout 0
            }
        }
        reverse_proxy app:8000
    }

    # Resto (UI, páginas, assets Next /_next/*, /client-portal, /admin, etc.).
    handle {
        reverse_proxy frontend:3000
    }

    # Headers de seguridad + HSTS (2 años · includeSubDomains · preload)
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
        -Server
        -X-Powered-By
    }

    log {
        output file /var/log/caddy/app.access.log {
            roll_size 50MB
            roll_keep 10
        }
        format json
    }
}
