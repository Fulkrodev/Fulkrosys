# =============================================================================
# FULKRO · .env.prod.template — PLANTILLA de entorno de PRODUCCIÓN (Hetzner)
#
# Este fichero SÍ se commitea (solo placeholders, sin secretos reales).
# El .env.prod REAL se genera/rellena así y NUNCA se commitea:
#
#   1) scripts/generate-prod-secrets.sh      → genera las vars SECRETAS (🔒)
#   2) editar .env.prod a mano               → rellenar las vars TUYAS (👤)
#
# Leyenda:
#   🔒 SECRETO    · lo genera generate-prod-secrets.sh · NO lo escribas a mano
#   👤 TUYO       · lo pones TÚ (Marcos): API key, dominio/DNS, SMTP
#   ⚙️  ENTORNO    · valor de infraestructura · normalmente vale el default de abajo
#
# Orden de provisión PG (NO es alembic · ver docs/deploy/HETZNER_DEPLOY_RUNBOOK.md):
#   init-extensions.sql → init-functions.sql → init-roles.sql (usa las passwords
#   de abajo) → alembic upgrade head (como fulkro_migrate) → seed →
#   REVOKE UPDATE/DELETE audit_log (R6).
# =============================================================================

# -----------------------------------------------------------------------------
# ⚙️  ENTORNO
# -----------------------------------------------------------------------------
APP_ENV=production

# -----------------------------------------------------------------------------
# 👤 TUYO · DOMINIO / DNS / TLS
#   APP_BASE_URL    URL pública del frontend (https://...). Caddy emite TLS auto.
#   ALLOWED_HOSTS   CSV de hostnames servidos (sin esquema). Debe incluir el de
#                   APP_BASE_URL. FastAPI TrustedHost + CORS lo usan.
#   WEBAUTHN_RP_ID  MISMO dominio que sirve el login (Yubikey ligado al RP_ID).
#                   Cambiarlo invalida las credenciales WebAuthn registradas.
#   WEBAUTHN_RP_NAME  Nombre mostrado en el prompt del autenticador.
# -----------------------------------------------------------------------------
APP_BASE_URL=https://app.fulkro.es
ALLOWED_HOSTS=app.fulkro.es
WEBAUTHN_RP_ID=app.fulkro.es
WEBAUTHN_RP_NAME=FULKRO

# -----------------------------------------------------------------------------
# 👤 TUYO · ANTHROPIC (LLM copiloto · Motor 11 + agentes)
#   Sin una API key real, el copiloto y los agentes LLM no funcionan.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
ANTHROPIC_FALLBACK_MODEL=claude-opus-4-6

# -----------------------------------------------------------------------------
# 👤 TUYO · SMTP (envío de emails · magic-links, notificaciones M20)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.REPLACE_ME
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=no-reply@fulkro.es
# ⚙️ ENTORNO · activa el ENVÍO REAL de emails. FIX P1-9: el default de config.py
# es 'mock' (descarta magic-links/notificaciones en silencio devolviendo
# email_sent=True). En producción DEBE ser 'smtp' (con los SMTP_* de arriba) o
# 'postmark_api' (con POSTMARK_API_TOKEN). startup_checks aborta si queda 'mock'.
EMAIL_BACKEND=smtp

# -----------------------------------------------------------------------------
# 🔒 SECRETO · CLAVES Ed25519 (formato PEM PKCS8 · igual que backend/app/auth/crypto.py)
#   FULKRO_AUTH_PRIVATE_KEY    firma JWT de session (post-MFA).
#   FULKRO_AUTH_PUBLIC_KEY     pareja DERIVADA de la private. La consume el
#                              MIDDLEWARE del frontend (jose.importSPKI) para
#                              verificar el JWT. CRÍTICO: debe ser la pareja
#                              EXACTA de la private del backend (OPS-052 72ª).
#                              El build del frontend la toma como build-arg/env.
#   FULKRO_ML_PRIVATE_KEY      magic links (M12) + signing intents (M25).
#   FULKRO_BACKUP_SIGNING_KEY  firma del manifest de backups (M25/M26).
#
#   Multi-línea entre comillas dobles (compat python-dotenv + jose).
# -----------------------------------------------------------------------------
FULKRO_AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
REPLACE_ME_GENERATED_BY_SCRIPT
-----END PRIVATE KEY-----"
FULKRO_AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
REPLACE_ME_DERIVED_FROM_PRIVATE
-----END PUBLIC KEY-----"
FULKRO_ML_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
REPLACE_ME_GENERATED_BY_SCRIPT
-----END PRIVATE KEY-----"
FULKRO_BACKUP_SIGNING_KEY="-----BEGIN PRIVATE KEY-----
REPLACE_ME_GENERATED_BY_SCRIPT
-----END PRIVATE KEY-----"
#   FULKRO_M05_SIGNING_PRIVATE_KEY  firma in-portal de contratos/intents (M05).
#   FULKRO_M06_SIGNING_PRIVATE_KEY  firma de documentos generados (M06).
#   FULKRO_M07_SIGNING_PRIVATE_KEY  firma de evidencias (M07).
#   FIX P0-1: estables cross-recreate. Antes los 3 motores autogeneraban su
#   clave en var/keys/ si faltaba → sin volumen persistente cada recreate del
#   contenedor rotaba la clave e invalidaba la verificación de TODA firma previa
#   (contratos, dossier ENAC, evidencias · trazabilidad ENAC/R6). Cada motor
#   deriva su pública en memoria (no se necesita env pública).
FULKRO_M05_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
REPLACE_ME_GENERATED_BY_SCRIPT
-----END PRIVATE KEY-----"
FULKRO_M06_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
REPLACE_ME_GENERATED_BY_SCRIPT
-----END PRIVATE KEY-----"
FULKRO_M07_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
REPLACE_ME_GENERATED_BY_SCRIPT
-----END PRIVATE KEY-----"

# -----------------------------------------------------------------------------
# 🔒 SECRETO · SECRETOS DE APLICACIÓN
#   APP_SECRET_KEY         deriva el cifrado Fernet de tokens OAuth (m16) y
#                          credenciales SSH de pentest (m08). >=32 chars.
#                          startup_checks ABORTA en prod si es débil/default.
#   BACKUP_ENCRYPTION_KEY  raw secret del que se deriva la Fernet key de backups
#                          (M26). >=16 chars.
# -----------------------------------------------------------------------------
APP_SECRET_KEY=REPLACE_ME_RANDOM_48B
BACKUP_ENCRYPTION_KEY=REPLACE_ME_RANDOM_48B

# -----------------------------------------------------------------------------
# 🔒 SECRETO · PostgreSQL · PASSWORDS DE ROLES
#   POSTGRES_PASSWORD          rol 'fulkro' (superuser · migraciones + seeds).
#   FULKRO_APP_DB_PASSWORD     rol 'fulkro_app' (NOSUPERUSER · runtime app · RLS).
#   FULKRO_MIGRATE_DB_PASSWORD rol 'fulkro_migrate' (Alembic prod · BYPASSRLS).
#   init-roles.sql consume estas passwords para CREATE ROLE ... LOGIN PASSWORD.
#
#   DATABASE_URL*  se componen a partir de las passwords. host = nombre del
#                  servicio postgres en el compose de prod (aquí: 'postgres').
#     · DATABASE_URL          runtime async (fulkro_app · asyncpg).
#     · DATABASE_URL_SYNC     runtime sync (fulkro_app).
#     · DATABASE_MIGRATE_URL  Alembic (fulkro_migrate) · leído por migrations/env.py.
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=REPLACE_ME_GENERATED
FULKRO_APP_DB_PASSWORD=REPLACE_ME_GENERATED
FULKRO_MIGRATE_DB_PASSWORD=REPLACE_ME_GENERATED
DATABASE_URL=postgresql+asyncpg://fulkro_app:REPLACE_ME_GENERATED@postgres:5432/fulkro
DATABASE_URL_SYNC=postgresql://fulkro_app:REPLACE_ME_GENERATED@postgres:5432/fulkro
DATABASE_MIGRATE_URL=postgresql://fulkro_migrate:REPLACE_ME_GENERATED@postgres:5432/fulkro

# -----------------------------------------------------------------------------
# ⚙️  REDIS (Celery broker + cache)
#   FIX P3-1: REDIS_PASSWORD lo genera generate-prod-secrets.sh; el compose pone
#   --requirepass. Celery lee FULKRO_REDIS_URL/RESULT (NO REDIS_URL) → deben
#   incluir la password y el host de servicio 'redis' del compose.
# -----------------------------------------------------------------------------
REDIS_PASSWORD=REPLACE_ME_GENERATED_BY_SCRIPT
REDIS_URL=redis://:REPLACE_ME@redis:6379/0
FULKRO_REDIS_URL=redis://:REPLACE_ME@redis:6379/1
FULKRO_REDIS_RESULT_URL=redis://:REPLACE_ME@redis:6379/2

# -----------------------------------------------------------------------------
# 🔒 SECRETO · MinIO (object storage local · 3 buckets)
#   MINIO_ROOT_USER / MINIO_ROOT_PASSWORD  credenciales root del servicio MinIO.
#   MINIO_ACCESS_KEY / MINIO_SECRET_KEY    las usa el backend (= root en MVP).
#   startup_checks ABORTA si MINIO_SECRET_KEY = "changeme".
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=REPLACE_ME_GENERATED
MINIO_ROOT_PASSWORD=REPLACE_ME_GENERATED
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_ME_GENERATED
MINIO_SECRET_KEY=REPLACE_ME_GENERATED
MINIO_BUCKET=fulkro

# -----------------------------------------------------------------------------
# 🔒 SECRETO (parcial) · BACKUP OFFSITE S3 (Hetzner Object Storage · pgBackRest)
#   BACKUP_S3_ACCESS_KEY / BACKUP_S3_SECRET_KEY  👤 las da Hetzner al crear el
#                          bucket de Object Storage · pégalas en .env.prod.
#   BACKUP_S3_ENDPOINT     ⚙️ endpoint regional (ej. Núremberg nbg1).
#   PGBACKREST_STANZA      ⚙️ nombre de la stanza de pgBackRest.
# -----------------------------------------------------------------------------
BACKUP_S3_ACCESS_KEY=REPLACE_WITH_HETZNER_OBJSTORE_ACCESS_KEY
BACKUP_S3_SECRET_KEY=REPLACE_WITH_HETZNER_OBJSTORE_SECRET_KEY
BACKUP_S3_ENDPOINT=https://nbg1.your-objectstorage.com
BACKUP_S3_BUCKET=backup-vault-fulkro
PGBACKREST_STANZA=fulkro-prod

# -----------------------------------------------------------------------------
# ⚙️  EMBEDDINGS (fastembed · e5-large 1024 dim)
# -----------------------------------------------------------------------------
EMBEDDINGS_MODEL=intfloat/multilingual-e5-large
EMBEDDINGS_ENDPOINT=http://fastembed:8080

# -----------------------------------------------------------------------------
# ⚙️  PRODUCTION-SAFETY GUARDS (no tocar salvo motivo)
# -----------------------------------------------------------------------------
CLOUD_MOCK_MODE_ALLOWED=false
VERIFACTU_QR_BASE_URL=https://www2.aeat.es/wlpl/TIKE-CONT/ValidarQR?

# -----------------------------------------------------------------------------
# ⚙️  M8 · PENTEST AUTÓNOMO (autopilot) · ejecución REAL de escáneres
#   USE_MCP_REAL=true → el autopilot ejecuta los escáneres REALES end-to-end
#   (nmap/nuclei/lynis/semgrep/trivy/testssl/prowler...), no mocks. Requiere que
#   los binarios estén presentes en el contenedor backend — instálalos con
#   `bash scripts/provision-scanners.sh` (corre dentro del contenedor o en build).
#   Los motores FÍSICAMENTE IMPOSIBLES en un VPS cloud (wireless/cracking/mobile/
#   redteam/phishing) se declinan SOLOS con su razón física
#   (mcp_client.scanner_capability) · NUNCA fingen un resultado.
#   Déjalo en false hasta provisionar los binarios; con false el autopilot
#   degrada honesto (run PARCIAL, coverage 0%). Un único flag controla todo.
# -----------------------------------------------------------------------------
USE_MCP_REAL=false

# -----------------------------------------------------------------------------
# ⚙️  M8 · INFRA OFENSIVA ON-DEMAND (tier dedicado · cracking/phishing/redteam)
#   mock-by-default: sin token NO levanta nada. Para activar la provisión real:
#     OFFENSIVE_PROVISIONER_ENABLED=true
#     HETZNER_CLOUD_TOKEN=...   👤 token API de Hetzner Cloud (Proyecto → Security)
#   La plataforma levanta una box efímera con las tools del tier, la usa DENTRO de
#   la autorización firmada del engagement y la DESTRUYE garantizado al cerrar
#   (zero standing access). wireless queda fuera (antena física on-site).
#   FRONTERA: es verificación ofensiva AUTORIZADA y SUPERVISADA; la prueba de
#   penetración certificable de ALTA (mp.s.3) sigue exigiendo pentester cualificado
#   e INDEPENDIENTE del implantador (el engagement lo exige y lo registra).
# -----------------------------------------------------------------------------
OFFENSIVE_PROVISIONER_ENABLED=false
HETZNER_CLOUD_TOKEN=

# -----------------------------------------------------------------------------
# 🔒 SECRETO (parcial) · M31 · WhatsApp Business (360dialog) · canal con cliente
#   Por defecto MOCK (no envía/recibe de verdad). Para activarlo de verdad:
#     WHATSAPP_PROVIDER=360dialog
#     DIALOG_360_API_KEY=...            👤 la da 360dialog tras KYC del número WABA
#     DIALOG_360_PHONE_NUMBER_ID=...    👤 id del número WhatsApp Business
#     DIALOG_360_WEBHOOK_SECRET=...     ⚙️ token compartido anti-spoofing · ponlo
#        TAMBIÉN en la URL del webhook en 360dialog:
#        https://<host>/api/v1/webhooks/360dialog?token=<este-secret>
#        (si queda vacío, el webhook NO se autentica · NO dejar vacío en prod)
#     DIALOG_360_OTP_TEMPLATE=...       ⚙️ nombre de la plantilla aprobada para el
#        OTP de opt-in (primer contacto · WhatsApp exige plantilla, no texto libre)
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER=mock
DIALOG_360_API_KEY=
DIALOG_360_PHONE_NUMBER_ID=
DIALOG_360_WEBHOOK_SECRET=
DIALOG_360_OTP_TEMPLATE=
