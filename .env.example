# FULKRO — Environment variables template
# Copy this file to .env and fill in the real values. NEVER commit .env.

# Anthropic API (required for Motor 11 Copiloto)
ANTHROPIC_API_KEY=sk-ant-api03-XXXXX
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
ANTHROPIC_FALLBACK_MODEL=claude-opus-4-6

# ENS Radar capability (ADR-013 + ADR-015)
# Lista de emails con acceso a /radar/* (capability operacional, no
# identidad). Acepta CSV o JSON list. Si no se setea, default = Marcos.
# ENS_RADAR_OWNERS=marcos@fulkro.es,partner@fulkro.es

# ENS Radar cinturon LLM (FASE 8.5 C1 backend, sub-bloque 8.5.K)
#   ENS_RADAR_COST_LIMIT_USD: techo de gasto Anthropic por run (USD).
#                             0 o negativo desactiva el limite.
#   ENS_RADAR_COST_LIMIT_MODE: "soft" (default · warn + continue) o
#                              "hard" (raise CostLimitExceeded · prod).
# ENS_RADAR_COST_LIMIT_USD=20.0
# ENS_RADAR_COST_LIMIT_MODE=soft

# Database (already configured elsewhere, here for reference)
# DATABASE_URL=postgresql+asyncpg://fulkro_app:fulkro_app_dev_password@localhost:5433/fulkro
# DATABASE_URL_SYNC=postgresql://fulkro_app:fulkro_app_dev_password@localhost:5433/fulkro
# Alembic migrations · NOSUPERUSER + BYPASSRLS · creado en init-roles.sql
# DATABASE_MIGRATE_URL=postgresql://fulkro_migrate:fulkro_migrate_dev_password@localhost:5433/fulkro

# M6 signing key path (defaults to var/keys/m6_signing_dev.ed25519.pem)
# M6_SIGNING_KEY_PATH=/home/usuario/fulkro/var/keys/m6_signing_dev.ed25519.pem

# Auth Ed25519 PRIVATE KEY (firma JWT session post-MFA verify)
# Generar permanente con:
#   openssl genpkey -algorithm Ed25519 -out priv.pem
#   openssl pkey -in priv.pem -pubout -out pub.pem
# La PUBLIC KEY correspondiente vive en frontend/.env (FULKRO_AUTH_PUBLIC_KEY).
# Sin set, backend genera ephemeral (tokens invalidados al restart, log warning).
# Multi-line PEM con quotes dobles funciona via python-dotenv.
# FULKRO_AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# <salida openssl genpkey -algorithm Ed25519>
# -----END PRIVATE KEY-----"

# OAuth providers — M16 portal connectors (SAN-E v3.MB-4.2.bis · Q2-A)
# Vacíos por default. Marcos configura local .env real cuando habilita
# cliente in-portal connectors. AWS NO usa OAuth · IAM access key paste.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base custom (Marcos configurable)
BASE_CLIENT_ID=
BASE_CLIENT_SECRET=
BASE_OAUTH_AUTHORIZE_URL=
BASE_OAUTH_TOKEN_URL=
BASE_OAUTH_SCOPES=

# Backup encryption (Motor 26 · ADR-043 · MB-10 Atom 10.6.A)
# Fernet AES-128-CBC key derived from this raw secret (SHA256 → base64).
# Min 16 chars · transitional env var · MB-12 Vault/SOPS forward externalization.
# Used by backend/app/motors/m26_backup/encryption.py
# Generate strong key:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKUP_ENCRYPTION_KEY=

# Backup offsite S3-compatible (Motor 26 · ADR-043 · MB-10 Atom 10.6.B)
# Dev: usa MINIO_* settings + bucket dedicated `backup-vault-fulkro`
#   (BUCKET_BACKUP_VAULT constant en backend/app/core/storage/minio_client.py)
# Prod cutover MB-11: Hetzner Object Storage (S3-compatible · misma API).
# Future swap: poblar BACKUP_S3_* y wire offsite.py a cliente separado.
# BACKUP_S3_ENDPOINT=https://nbg1.your-objectstorage.com  # Hetzner Nuremberg
# BACKUP_S3_BUCKET=backup-vault-fulkro
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

# Cloud Connectors mock_mode production-safety guard (sub-atom 1.D.X.B v3.12)
# DEFAULT: false (production-safe) · CloudConnectorService.trigger_sync raises
# MockModeNotAllowedError si admin pulsa "Forzar sync" sin credenciales OAuth
# (m16_credentials=None) en un OAuth provider (Microsoft 365, Azure, AWS,
# Google Workspace, GitHub). En producción mock_mode auto-resolvería gaps
# reales con dataset vacío · borrando trazabilidad ENAC silenciosamente.
# MANUAL_IMPORT exento (uso legítimo · upload Excel/CSV via m24_idms).
# Set true ONLY for dev/test/piloto demo. NEVER enable in production.
CLOUD_MOCK_MODE_ALLOWED=false
