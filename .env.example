# =============================================================================
# FULKRO · plantilla de variables de entorno del BACKEND
#
# Copia este fichero a `.env` y rellena los valores reales. NUNCA commitees
# `.env` (está en .gitignore). La plantilla de PRODUCCIÓN es otro fichero
# distinto: `.env.prod.template`.
#
# Este fichero está vigilado por un test:
#   backend/tests/test_env_example_completeness.py
# que falla si el código lee una variable de arranque/credencial que aquí no
# esté documentada. El criterio exacto está en el docstring de ese test.
# -----------------------------------------------------------------------------
#
# TRAMPA 1 · copiar el fichero NO basta para arrancar.
#   pydantic-settings lee `.env` para poblar `Settings`, pero NO exporta nada a
#   `os.environ`, y `backend/app/startup_checks.py` lee `os.environ` a pelo. Por
#   eso hay que arrancar con el fichero de entorno explícito:
#       uvicorn backend.app.main:app --env-file .env
#   o exportarlo de verdad antes:
#       set -a; . ./.env; set +a
#   Comprobación de que la trampa es real (con el .env ya creado):
#       python -c "import os; print(os.environ.get('DATABASE_URL'))"   # -> None
#       python -c "from backend.app.config import get_settings; \
#                  print(get_settings().database_url)"                  # -> sí lo ve
#
# TRAMPA 2 · las variables de `Settings` NO llevan prefijo `FULKRO_`.
#   `backend/app/config.py` no declara `env_prefix`, así que el prefijo efectivo
#   es la cadena vacía y cada campo se lee por su nombre en mayúsculas:
#   el campo `minio_secret_key` se lee de MINIO_SECRET_KEY, NO de
#   FULKRO_MINIO_SECRET_KEY (varios comentarios del código dicen lo contrario;
#   son erróneos). Comprobación:
#       python -c "from backend.app.config import Settings; \
#                  print(repr(Settings.model_config['env_prefix']))"    # -> ''
#   Las que SÍ llevan prefijo `FULKRO_` son las que el código lee directamente
#   con `os.environ` (FULKRO_AUTH_PRIVATE_KEY, FULKRO_ML_PRIVATE_KEY, ...).
#   Comprobación de que no hay prefijo por ningún lado:
#       grep -rn "env_prefix" backend/app/config.py                     # -> 0 líneas
#
# TRAMPA 3 · `Settings.is_production` es igualdad estricta con "production".
#   Con APP_ENV=prod NO estás en producción para `config.py` (sí para
#   `backend/app/core/signing_keys.py`, que acepta "production" y "prod").
#   Escribe siempre APP_ENV=production. Comprobación:
#       grep -n "is_production" -A2 backend/app/config.py
# =============================================================================


# =============================================================================
# 1 · OBLIGATORIAS · sin estas cuatro el backend ABORTA al arrancar
#     backend/app/startup_checks.py:_REQUIRED_ENV_VARS
#     Comprobación:
#       python -c "from backend.app.startup_checks import _REQUIRED_ENV_VARS as r; print(r)"
# =============================================================================

# Conexión de la aplicación (rol fulkro_app · NOSUPERUSER · RLS aplicada).
# La contraseña coincide con la que crea infra/docker/init-roles.sql:15.
# El puerto 5433 es el de docker-compose.yml de desarrollo (el demo publica
# Postgres en 127.0.0.1:15432 y genera su propio .env.demo).
DATABASE_URL=postgresql+asyncpg://fulkro_app:fulkro_app_dev_password@localhost:5433/fulkro

# Las TRES claves Ed25519 restantes son PLACEHOLDERS a propósito: aquí no va
# ningún material criptográfico literal. Genéralas (idempotente · no pisa las que
# ya existan) con:
#
#     python scripts/generate_dev_signing_keys.py --env-file .env
#
# Ese script escribe en tu `.env` las tres privadas más FULKRO_AUTH_PUBLIC_KEY
# (derivada de la privada de AUTH) y la sincroniza en frontend/.env, que es la
# que usa frontend/middleware.ts para verificar el JWT de sesión.
#
# Formato: PEM PKCS#8 multilínea entre comillas dobles. Ejemplo de la forma
# (NO es una clave válida):
#
# FULKRO_AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# <PEGA AQUI LA SALIDA DE openssl genpkey -algorithm Ed25519>
# -----END PRIVATE KEY-----"
#
# Firma el JWT de sesión emitido tras verificar el segundo factor.
# FULKRO_AUTH_PRIVATE_KEY=
#
# Firma los magic links del portal de cliente y de auditor (M12 · R5).
# FULKRO_ML_PRIVATE_KEY=
#
# Firma los manifiestos de backup (M25/M26 · R8).
# FULKRO_BACKUP_SIGNING_KEY=

# Pública correspondiente a FULKRO_AUTH_PRIVATE_KEY. El backend la ignora
# (config.py declara extra="ignore"); la lee el frontend
# (frontend/middleware.ts) y también frontend/.env. Se documenta aquí porque
# un despliegue de un solo fichero de entorno se la pasa al contenedor del
# frontend desde este mismo sitio.
# FULKRO_AUTH_PUBLIC_KEY=


# =============================================================================
# 2 · BASE DE DATOS · resto de conexiones
# =============================================================================

# Variante síncrona (scripts de seed, corpus, herramientas puntuales).
DATABASE_URL_SYNC=postgresql://fulkro_app:fulkro_app_dev_password@localhost:5433/fulkro

# Alembic · rol fulkro_migrate (BYPASSRLS · creado en init-roles.sql:146).
# EXPÓRTALA SIEMPRE antes de migrar: si falta, backend/migrations/env.py cae al
# valor cableado en backend/alembic.ini:3 y migrarías otra base sin enterarte.
#   grep -n "sqlalchemy.url" backend/alembic.ini
DATABASE_MIGRATE_URL=postgresql://fulkro_migrate:fulkro_migrate_dev_password@localhost:5433/fulkro


# =============================================================================
# 3 · APLICACIÓN
# =============================================================================

# development | staging | production. Ojo con la TRAMPA 3 de la cabecera:
# "prod" NO cuenta como producción para config.py, y con cualquier valor
# distinto de "production" queda MONTADO el router /api/v1/_dev (16 endpoints,
# incluido login-as-marcos). Comprobación:
#   grep -rn "_dev" backend/app/main.py | head
APP_ENV=development

# Deriva el cifrado Fernet de los tokens OAuth (M16) y de las credenciales SSH
# de pentest (M08). En producción el arranque ABORTA si vale el default
# "change-this" o mide menos de 32 caracteres (verify_app_secret_key).
# Genera una:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-this

# URL pública del frontend y hostnames servidos (CSV, sin esquema).
APP_BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# Versión mostrada en /admin/settings/about (deploy: git describe).
# APP_VERSION=dev

# WebAuthn (Yubikey del administrador · R4). RP_ID = dominio que sirve el
# login; cambiarlo invalida las credenciales ya registradas.
WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=FULKRO

# Tamaño máximo del cuerpo de una petición, en MB (default 100).
# backend/app/middleware/body_limit.py
# FULKRO_MAX_REQUEST_BODY_MB=100

# Salta las precondiciones entre motores (categorización firmada, DdA congelada,
# ...). La suite de tests lo pone a 1. NUNCA en producción.
# backend/app/core/workflow_gates.py
# FULKRO_SKIP_WORKFLOW_GATES=

# Lo pone el conftest de la suite: desactiva los startup checks y fuerza
# is_production()=False. No lo pongas a mano en un entorno servido.
# FULKRO_TESTING=


# =============================================================================
# 4 · REDIS / CELERY
# =============================================================================

REDIS_URL=redis://localhost:6379/0

# Celery usa SUS PROPIAS variables (no reutiliza REDIS_URL):
# backend/app/core/celery_app.py:49-50
# FULKRO_REDIS_URL=redis://localhost:6379/1
# FULKRO_REDIS_RESULT_URL=redis://localhost:6379/2
# FULKRO_CELERY_TIME_LIMIT=
# FULKRO_CELERY_SOFT_TIME_LIMIT=


# =============================================================================
# 5 · MINIO / S3
# Recuerda la TRAMPA 2: es MINIO_SECRET_KEY, sin prefijo FULKRO_.
# =============================================================================

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=fulkro
# Default de config.py: "changeme". Cámbialo en cualquier entorno servido.
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=fulkro
# Base absoluta para construir enlaces a objetos de buckets con lectura pública.
MINIO_PUBLIC_URL=http://localhost:9000
# true si el endpoint S3 es externo y habla HTTPS (Hetzner Object Storage).
# MINIO_USE_TLS=false


# =============================================================================
# 6 · ANTHROPIC (copiloto M11 + agentes)
# =============================================================================

ANTHROPIC_API_KEY=sk-ant-api03-XXXXX
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
ANTHROPIC_FALLBACK_MODEL=claude-opus-4-6

# Vuelca a disco los prompts/respuestas de los agentes (depuración).
# FULKRO_AGENT_DEBUG_DUMPS=

# Los tests marcados @pytest.mark.llm hacen llamadas REALES a la API (coste +
# red). Se saltan salvo opt-in explícito.
# FULKRO_RUN_LLM_TESTS=


# =============================================================================
# 7 · EMAIL (magic links R5 + notificaciones M20)
# Con EMAIL_BACKEND=mock los envíos se descartan en silencio devolviendo
# email_sent=True. En producción el arranque aborta si sigue en mock.
# =============================================================================

# smtp | postmark_api | mock
EMAIL_BACKEND=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM=FULKRO <noreply@fulkro.es>
# SMTP_USE_TLS=true
POSTMARK_API_TOKEN=

# Destinatario de las notificaciones internas de administración.
# MARCOS_ADMIN_EMAIL=marcosmata@fulkro.es
# Fallbacks leídos con os.environ en dos rutas concretas:
#   backend/app/notifications/post_signoff_hooks.py:291 (evidencia en cuarentena)
#   backend/app/motors/m25_lifecycle/tasks.py:67       (checkpoints de gracia)
# FULKRO_ADMIN_EMAIL=
# FULKRO_MARCOS_EMAIL=
# Base pública del portal usada por las tareas Celery de M25 al construir enlaces.
# FULKRO_PORTAL_BASE_URL=https://portal.fulkro.es
# Destinatario del formulario de contacto de la landing.
# backend/app/api/v1/public_contact.py:24
# CONTACT_EMAIL=


# =============================================================================
# 8 · CONECTORES OAUTH DEL PORTAL DE CLIENTE (M16)
# Vacíos por defecto. AWS no usa OAuth (se pega una access key de IAM).
# =============================================================================

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Proveedor OAuth genérico configurable a mano
BASE_CLIENT_ID=
BASE_CLIENT_SECRET=
BASE_OAUTH_AUTHORIZE_URL=
BASE_OAUTH_TOKEN_URL=
BASE_OAUTH_SCOPES=

# Guardia de seguridad del sincronizado en modo simulado. Con false (default),
# "Forzar sync" sin credenciales OAuth lanza MockModeNotAllowedError en lugar de
# resolver huecos reales contra un dataset vacío. NUNCA true en producción.
CLOUD_MOCK_MODE_ALLOWED=false


# =============================================================================
# 9 · CIFRADO Y CLAVES DE FIRMA ADICIONALES
# Todas opcionales en desarrollo (hay fallback o clave efímera con warning);
# obligatorias en cualquier entorno donde las firmas deban sobrevivir a un
# reinicio.
# =============================================================================

# Fernet maestra del cifrado de datos en reposo. Sin ella se deriva de
# FULKRO_AUTH_PRIVATE_KEY con un warning (backend/app/core/encryption/master_key.py).
# Genera:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FULKRO_MASTER_ENCRYPTION_KEY=
# Claves Fernet antiguas, una por línea, para poder descifrar tras una rotación.
# FULKRO_KEY_ROTATION_HISTORY=

# Fernet usada al enviar incidentes a LUCIA (M19).
# backend/app/motors/m19_risk/incident_workflow_service.py:235
# FULKRO_FERNET_KEY=

# Firma de las órdenes que ejecutan los agentes de remediación (semilla en hex).
# Sin ella en producción, agent_service aborta.
# FULKRO_REMEDIATION_SIGNING_KEY=
# Interruptor global de la remediación automática (default false · fail-closed).
# FULKRO_REMEDIATION_ENABLED=false

# Claves Ed25519 por motor de firma (contratos M05, documentos M06, evidencias
# M07). En producción se inyectan; en desarrollo cada motor genera la suya en
# disco. NOTA: el barrido AST del test no las ve porque no se leen con
# os.environ sino como argumento `env_var=` de load_signing_private_key:
#   grep -rn 'env_var=' backend/app
# FULKRO_M05_SIGNING_PRIVATE_KEY=
# FULKRO_M06_SIGNING_PRIVATE_KEY=
# FULKRO_M07_SIGNING_PRIVATE_KEY=
# Rutas en disco de las claves de desarrollo (M05 y M06 tienen defaults bajo var/).
# M05_SIGNING_PRIVATE_KEY_PATH=
# M05_SIGNING_PUB_KEY_PATH=
# M6_SIGNING_KEY_PATH=
# M6_SIGNING_PUB_KEY_PATH=

# Sellado de tiempo RFC 3161 sobre las firmas (desactivado por defecto).
# FULKRO_TIMESTAMP_ENABLED=false
# FULKRO_TSA_URL=
# FULKRO_TSA_TIMEOUT=10
# FULKRO_TSA_CA_BUNDLE=

# Certificado para la firma XAdES de facturas Facturae (M15).
# FULKRO_FACTURAE_CERT_PATH=


# =============================================================================
# 10 · BACKUP (M26 · R8)
# =============================================================================

# Secreto del que se deriva la Fernet que cifra los backups (mínimo 16 chars).
# En producción el arranque aborta si falta o empieza por REPLACE_ME.
# Genera:  python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKUP_ENCRYPTION_KEY=

# Destino offsite S3. En desarrollo se usa MinIO con el bucket backup-vault-fulkro.
# BACKUP_S3_ENDPOINT=https://nbg1.your-objectstorage.com
# BACKUP_S3_BUCKET=backup-vault-fulkro
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# PGBACKREST_STANZA=fulkro


# =============================================================================
# 11 · EVIDENCIAS Y ALMACENAMIENTO INMUTABLE (M07)
# =============================================================================

# Antivirus clamd (la evidencia solo llega al bucket WORM si sale limpia).
# CLAMD_HOST=localhost
# CLAMD_PORT=3310
# CLAMD_TIMEOUT_SECONDS=25
# Retención WORM en días (default 2555 = 7 años · Art. 24 ENS).
# FULKRO_WORM_RETENTION_DAYS=2555
# Límites de tamaño del dossier de auditoría, en MB.
# FULKRO_DOSSIER_SINGLE_BINARY_MB=
# FULKRO_DOSSIER_TOTAL_BINARY_MB=
# Carpeta de los artefactos de acompañamiento de auditoría (bajo var/ por
# defecto: /tmp los perdía al recrear el contenedor).
# FULKRO_ACCOMPANIMENT_ARTIFACTS_PATH=var/audit_accompaniment_artifacts


# =============================================================================
# 12 · PENTEST / MCP (M08)
# =============================================================================

# false (default) → invoke_mcp() devuelve un stub honesto y NO ejecuta binarios.
# Ponlo a true SOLO si la imagen del backend lleva los escáneres instalados
# (infra/docker/Dockerfile). Ver docs/operations/PENTEST_REAL_SCANNERS_HETZNER.md
USE_MCP_REAL=false

# OpenVAS/GVM externo (backend/app/motors/m08_verification/tools/openvas_runner.py)
# GVM_HOST=
# GVM_PORT=
# GVM_USERNAME=
# GVM_PASSWORD=
# OWASP ZAP
# FULKRO_ZAP_URL=
# VPN para alcanzar la red del cliente durante el pentest
# FULKRO_VPN_SERVER=
# FULKRO_VPN_PORT=
# FULKRO_VPN_PROTO=

# Provisión efímera de la caja ofensiva en Hetzner Cloud. Sin token no levanta
# nada (devuelve una caja simulada).
# OFFENSIVE_PROVISIONER_ENABLED=false
HETZNER_CLOUD_TOKEN=
# OFFENSIVE_BOX_IMAGE=ubuntu-24.04
# OFFENSIVE_BOX_LOCATION=nbg1

# Sonda de detección de intrusiones del monitor de cumplimiento.
# FULKRO_IDS_ENABLED=


# =============================================================================
# 13 · WHATSAPP (M31 · opcional)
# =============================================================================

# mock (default) | 360dialog
# WHATSAPP_PROVIDER=mock
DIALOG_360_API_KEY=
DIALOG_360_WEBHOOK_SECRET=
# DIALOG_360_PHONE_NUMBER_ID=
# DIALOG_360_OTP_TEMPLATE=
# Número informativo del pie de los emails (texto plano, sin enlace). Vacío →
# el pie no incluye la sección de WhatsApp.
# MARCOS_WHATSAPP_NUMBER=
# MARCOS_WHATSAPP_HOURS=de 9:00 a 18:00 L-V
# Interruptor de las notificaciones por WhatsApp (default true).
# WHATSAPP_NOTIFICATIONS_ENABLED=true


# =============================================================================
# 14 · VARIOS
# =============================================================================

# Datos de contacto del consultor expuestos en los portales magic-link.
# CONSULTOR_NAME=FULKRO Consultor
# CONSULTOR_EMAIL=consultor@fulkro.es
# CONSULTOR_PHONE_EMERGENCY=+34 000 000 000

# Cuenta bancaria para las instrucciones de transferencia de las facturas.
# Vacía → el email de factura no incluye esa sección.
# MARCOS_BANK_IBAN=
# MARCOS_BANK_HOLDER=Marcos Mata García
# MARCOS_BANK_INSTITUTION=Banco Santander
# MARCOS_BANK_BIC=

# Base del validador de QR de Verifactu (RD 1007/2023). El default es
# PREPRODUCCIÓN; en producción el QR sería inescaneable sin cambiarla.
# VERIFACTU_QR_BASE_URL=https://www2.aeat.es/wlpl/TIKE-CONT/ValidarQR?

# Umbral de inactividad del cliente, en días, para la alerta de M20.
# CLIENT_INACTIVITY_THRESHOLD_DAYS=14
# Confianza por debajo de la cual el copiloto considera que hay hueco de corpus.
# CORPUS_GAP_CONFIDENCE_THRESHOLD=0.45
# Tipo de interés del BCE forzado a mano para el cálculo de intereses de demora.
# FULKRO_BCE_RATE_OVERRIDE=
# Base de datos MaxMind GeoLite2 para geolocalizar la IP de los magic links.
# Sin fichero → el campo queda a None (degradación grácil).
# FULKRO_GEOIP_DB_PATH=

# Nombre del modelo de embeddings (fastembed, en proceso).
# EMBEDDINGS_MODEL=intfloat/multilingual-e5-large

# OBSOLETA · el endpoint HTTP de embeddings ya no se usa: fastembed corre EN
# PROCESO. El campo sigue declarado en config.py, pero nadie lee su valor.
#   grep -rn "embeddings_endpoint" backend/app --include=*.py
#   -> solo la declaración en backend/app/config.py
# EMBEDDINGS_ENDPOINT=http://localhost:8080


# =============================================================================
# 15 · VARIABLES RETIRADAS (documentadas para que nadie las resucite)
# =============================================================================
#
# ENS_RADAR_OWNERS, ENS_RADAR_COST_LIMIT_USD y ENS_RADAR_COST_LIMIT_MODE
# ELIMINADAS: el subsistema ENS Radar se retiró del producto (migración
# drop_ens_radar_001) y ningún fichero de código las lee. Comprobación:
#   command grep -rn "ENS_RADAR" --include=*.py --include=*.ts --include=*.tsx \
#       --include=*.yml --include=*.sh . | grep -v '^./docs/'
#   -> 0 líneas
# (Usa `command grep`: el `grep` de este shell es una función que respeta
#  .gitignore y omite ficheros versionados en silencio.)
#
# Variables de SDK de terceros que el código lee pero que NO se documentan aquí
# a propósito (las fija el entorno del proveedor, no FULKRO):
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY  -> prowler / scoutsuite
#   GOOGLE_APPLICATION_CREDENTIALS             -> scoutsuite (GCP)
# Están en la lista de excepciones comentada de
# backend/tests/test_env_example_completeness.py
