{% extends "_email_base.mjml" %}

{% block subject %}{{ tokens.BRAND_NAME }} · Notificación importante (Art. 34 RGPD){% endblock %}
{% block preview %}Notificación de incidente conforme al Art. 34 RGPD · {{ breach.breach_code }}{% endblock %}
{% block header_tag %}Art. 34 RGPD{% endblock %}

{% block hero_badge %}
  <span class="pill" style="background:{{ severity_solid(breach.severity) }};color:#ffffff;">Incidente</span>
{% endblock %}

{% block hero %}
  <mj-text font-size="22px" font-weight="700" color="{{ tokens.TEXT_PRIMARY }}" padding-bottom="6px" line-height="1.3">
    Notificación de incidente de seguridad
  </mj-text>
  <mj-text color="{{ tokens.TEXT_SECONDARY }}" font-size="13px">
    Te informamos conforme al Artículo 34 del Reglamento (UE) 2016/679.
  </mj-text>
{% endblock %}

{% block content %}
  <mj-raw>
    <div style="margin:0 0 18px 0;padding:14px 16px;background:#fef3c7;border-left:4px solid {{ tokens.SEVERITY_MEDIUM }};border-radius:6px;font-size:13px;color:#7c2d12;line-height:1.55;">
      <strong style="display:block;margin-bottom:4px;font-size:13px;">Detección: {{ breach.detected_at.strftime("%Y-%m-%d") }}</strong>
      FULKRO ha detectado un incidente de seguridad que ha podido afectar a datos personales asociados a tu cuenta.
    </div>

    <div style="margin:0 0 14px 0;padding:14px 16px;background:{{ tokens.BG_SECTION_SUBTLE }};border:1px solid {{ tokens.BORDER_SUBTLE }};border-radius:8px;">
      <div class="card-title">Qué ha ocurrido</div>
      <div class="muted" style="font-size:13px;margin-top:4px;line-height:1.55;white-space:pre-wrap;">{{ breach.description }}</div>
    </div>

    <div style="margin:0 0 14px 0;padding:14px 16px;background:{{ tokens.BG_SECTION_SUBTLE }};border:1px solid {{ tokens.BORDER_SUBTLE }};border-radius:8px;">
      <div class="card-title">Qué datos podrían haberse visto afectados</div>
      <ul style="margin:6px 0 0 18px;color:{{ tokens.TEXT_SECONDARY }};font-size:13px;line-height:1.55;">
        {% for cat in breach.data_categories_affected %}
          <li style="margin:2px 0;">{{ cat }}</li>
        {% endfor %}
      </ul>
    </div>

    <div style="margin:0 0 14px 0;padding:14px 16px;background:{{ tokens.BG_SECTION_SUBTLE }};border:1px solid {{ tokens.BORDER_SUBTLE }};border-radius:8px;">
      <div class="card-title">Medidas adoptadas por FULKRO</div>
      <div class="muted" style="font-size:13px;margin-top:4px;line-height:1.55;white-space:pre-wrap;">{{ breach.containment_actions or "Continuamos investigando el incidente y aplicando medidas correctivas." }}</div>
    </div>

    <div style="margin:0 0 14px 0;padding:14px 16px;background:{{ tokens.BG_SECTION_SUBTLE }};border:1px solid {{ tokens.BORDER_SUBTLE }};border-radius:8px;">
      <div class="card-title">Qué te recomendamos hacer</div>
      <ul style="margin:6px 0 0 18px;color:{{ tokens.TEXT_SECONDARY }};font-size:13px;line-height:1.55;">
        <li style="margin:2px 0;">Revisa la actividad reciente en tu cuenta del portal cliente.</li>
        <li style="margin:2px 0;">Cambia tu contraseña si lo consideras oportuno.</li>
        <li style="margin:2px 0;">Activa la verificación en dos pasos (2FA TOTP) desde tu perfil.</li>
        <li style="margin:2px 0;">Atención a correos no solicitados que mencionen este incidente.</li>
      </ul>
    </div>

    <div style="margin:0 0 14px 0;padding:14px 16px;background:{{ tokens.BG_SECTION_SUBTLE }};border:1px solid {{ tokens.BORDER_SUBTLE }};border-radius:8px;">
      <div class="card-title">Tus derechos</div>
      <div class="muted" style="font-size:13px;margin-top:4px;line-height:1.55;">
        Puedes ejercer los derechos de acceso (Art. 15), rectificación (Art. 16), supresión (Art. 17), portabilidad (Art. 20) y limitación desde el portal cliente. También puedes presentar una reclamación ante la AEPD: <a class="accent-link" href="https://www.aepd.es">aepd.es</a>.
      </div>
    </div>
  </mj-raw>

  <mj-button background-color="{{ tokens.PRIMARY }}" href="{{ tokens.LEGAL_BASE_URL }}/client-portal/account" align="center" padding-top="8px">
    Ejercer mis derechos
  </mj-button>

  <mj-text color="{{ tokens.TEXT_MUTED }}" font-size="11px" align="center" padding-top="14px">
    Código interno del incidente: <span class="mono">{{ breach.breach_code }}</span> · Enviado a {{ cliente_email }} el {{ now.strftime("%Y-%m-%d %H:%M %Z") }}
  </mj-text>
{% endblock %}
