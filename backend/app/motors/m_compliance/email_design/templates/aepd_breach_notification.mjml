{% extends "_email_base.mjml" %}

{% block subject %}AEPD · Notificación brecha · {{ breach.breach_code }}{% endblock %}
{% block preview %}Art. 33 RGPD · {{ breach.breach_code }} · severidad {{ breach.severity|upper }}{% endblock %}
{% block header_tag %}Art. 33 RGPD · 72h SLA{% endblock %}

{% block hero_badge %}
  <span class="pill" style="background:{{ severity_solid(breach.severity) }};color:#ffffff;">{{ breach.severity|upper }}</span>
{% endblock %}

{% block hero %}
  <mj-text font-size="22px" font-weight="700" color="{{ tokens.TEXT_PRIMARY }}" padding-bottom="6px" line-height="1.3">
    Notificación de violación de seguridad de datos personales
  </mj-text>
  <mj-text color="{{ tokens.TEXT_SECONDARY }}" font-size="13px">
    Código interno <span class="mono" style="color:{{ tokens.TEXT_PRIMARY }};">{{ breach.breach_code }}</span> · Artículo 33 RGPD (UE 2016/679)
  </mj-text>
{% endblock %}

{% set section_card_style = "margin:0 0 14px 0;padding:14px 16px;background:" ~ tokens.BG_SECTION_SUBTLE ~ ";border:1px solid " ~ tokens.BORDER_SUBTLE ~ ";border-left:3px solid " ~ severity_solid(breach.severity) ~ ";border-radius:8px;" %}

{% block content %}
  <mj-raw>
    <div style="{{ section_card_style }}">
      <div class="card-title">1. Responsable del tratamiento (Art. 28 · 30 RGPD)</div>
      <div class="muted" style="font-size:13px;margin-top:4px;line-height:1.55;">
        {{ fiscal.nombre_fiscal or 'Marcos Mata García' }} ({{ fiscal.nombre_comercial or 'FULKRO' }}) · {{ fiscal.domicilio_completo or 'Madrid, España' }}<br />
        CIF: {{ fiscal.nif or '[pendiente · configurar en /admin/settings/fiscal]' }}<br />
        DPO: <a class="accent-link" href="mailto:dpo@fulkro.es">dpo@fulkro.es</a>
      </div>
    </div>

    <div style="{{ section_card_style }}">
      <div class="card-title">2. Naturaleza de la violación (Art. 33.3.a)</div>
      <div class="muted" style="font-size:13px;margin-top:4px;line-height:1.55;white-space:pre-wrap;">{{ breach.description }}</div>
    </div>

    <div style="{{ section_card_style }}">
      <div class="card-title">3. Categorías de datos afectadas (Art. 33.3.a)</div>
      <ul style="margin:6px 0 0 18px;color:{{ tokens.TEXT_SECONDARY }};font-size:13px;line-height:1.55;">
        {% for cat in breach.data_categories_affected %}
          <li style="margin:2px 0;">{{ cat }}</li>
        {% endfor %}
      </ul>
    </div>

    <div style="{{ section_card_style }}">
      <div class="card-title">4. Número aproximado de interesados (Art. 33.3.a)</div>
      <div class="muted" style="font-size:13px;margin-top:4px;">
        <strong style="color:{{ tokens.TEXT_PRIMARY }};">{{ breach.data_subjects_count or "en cuantificación" }}</strong>
      </div>
    </div>

    <div style="{{ section_card_style }}">
      <div class="card-title">5. Datos de contacto del DPO (Art. 33.3.b)</div>
      <div class="muted" style="font-size:13px;margin-top:4px;line-height:1.55;">
        Marcos Mata García · DPO interim · <a class="accent-link" href="mailto:dpo@fulkro.es">dpo@fulkro.es</a>
      </div>
    </div>

    <div style="{{ section_card_style }}">
      <div class="card-title">6. Consecuencias probables (Art. 33.3.c)</div>
      <div class="muted" style="font-size:13px;margin-top:4px;line-height:1.55;">
        Severidad valorada: <span class="pill" style="background:{{ severity_solid(breach.severity) }};color:#ffffff;">{{ breach.severity|upper }}</span><br />
        Se evaluarán consecuencias específicas conforme avance la investigación y se actualizará la presente notificación con la información requerida por el Art. 33.4 RGPD si procede.
      </div>
    </div>

    <div style="{{ section_card_style }}">
      <div class="card-title">7. Causa raíz</div>
      <div class="muted" style="font-size:13px;margin-top:4px;line-height:1.55;white-space:pre-wrap;">{{ breach.root_cause or "Investigación en curso." }}</div>
    </div>

    <div style="{{ section_card_style }}">
      <div class="card-title">8. Medidas de contención adoptadas (Art. 33.3.d)</div>
      <div class="muted" style="font-size:13px;margin-top:4px;line-height:1.55;white-space:pre-wrap;">{{ breach.containment_actions or "Medidas en curso." }}</div>
    </div>

    <div style="{{ section_card_style }}">
      <div class="card-title">9. Medidas propuestas (Art. 33.3.d)</div>
      <div class="muted" style="font-size:13px;margin-top:4px;line-height:1.55;white-space:pre-wrap;">{{ breach.remediation_actions or "En definición." }}</div>
    </div>

    <div style="margin:16px 0 0 0;padding:14px 16px;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;font-size:12px;color:#7f1d1d;line-height:1.5;">
      <strong>Cronología 72h SLA Art. 33.1 RGPD</strong><br />
      Detección: {{ breach.detected_at.strftime("%Y-%m-%d %H:%M %Z") }} · Notificación enviada: {{ now.strftime("%Y-%m-%d %H:%M %Z") }}
    </div>
  </mj-raw>
{% endblock %}
