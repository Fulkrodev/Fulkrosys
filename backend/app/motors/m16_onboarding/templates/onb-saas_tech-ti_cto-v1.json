      "options": [
        {
          "value": "python",
          "label": "Python (Django, FastAPI, Flask)"
        },
        {
          "value": "node_js",
          "label": "Node.js / TypeScript"
        },
        {
          "value": "java_spring",
          "label": "Java / Spring Boot"
        },
        {
          "value": "dotnet",
          "label": ".NET / C#"
        },
        {
          "value": "go",
          "label": "Go"
        },
        {
          "value": "ruby_rails",
          "label": "Ruby on Rails"
        },
        {
          "value": "otro",
          "label": "Otro"
        }
