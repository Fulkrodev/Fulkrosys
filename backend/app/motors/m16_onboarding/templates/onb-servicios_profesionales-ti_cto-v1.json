{
  "id": "onb-servicios_profesionales-ti_cto-v1",
  "version": "1.0",
  "sector": "servicios_profesionales",
  "role": "ti_cto",
  "nombre": "Onboarding Responsable TI — Servicios Profesionales",
  "descripcion": "Onboarding para el responsable de TI o CTO en despacho/consultora/gestoria. Recoge stack tecnologico, identidad, cloud, MFA, seguridad perimetral.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-email_identidad",
      "type": "single_select",
      "section": "identidad",
      "label": "Que plataforma de identidad y correo usais principalmente?",
      "tooltip": "La identidad es el control mas critico del ENS.",
      "options": [
        {
          "value": "microsoft_365",
          "label": "Microsoft 365 / Entra ID"
        },
        {
          "value": "google_workspace",
          "label": "Google Workspace"
        },
        {
          "value": "on_prem_ad",
          "label": "Active Directory on-premise"
        },
        {
          "value": "mixto",
          "label": "Mixto / hibrido"
        },
        {
          "value": "otro",
          "label": "Otro"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-mfa_universal",
      "type": "single_select",
      "section": "identidad",
      "label": "El MFA esta habilitado de forma obligatoria para todos los usuarios?",
      "tooltip": "MFA universal es requisito de ENS Medio y Alto (op.acc.6 R2).",
      "options": [
        {
          "value": "si_todos",
          "label": "Si, para todos los usuarios"
        },
        {
          "value": "solo_privilegiados",
          "label": "Solo para usuarios privilegiados"
        },
        {
          "value": "voluntario",
          "label": "Voluntario (no obligatorio)"
        },
        {
          "value": "no",
          "label": "No esta habilitado"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-cloud_providers",
      "type": "multi_select",
      "section": "infraestructura",
      "label": "Que proveedores cloud usais?",
      "tooltip": "Cada cloud tiene sus propias medidas de seguridad aplicables (op.nub.*).",
      "options": [
        {
          "value": "aws",
          "label": "AWS"
        },
        {
          "value": "azure",
          "label": "Azure"
        },
        {
          "value": "gcp",
          "label": "Google Cloud Platform"
        },
        {
          "value": "ovh",
          "label": "OVH/Hetzner/otros europeos"
        },
        {
          "value": "on_prem_only",
          "label": "Solo infraestructura propia"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-num_empleados_ti",
      "type": "number",
      "section": "infraestructura",
      "label": "Cuantas personas componen el equipo de TI/Sistemas?",
      "tooltip": "El tamano del equipo TI determina que puede hacerse in-house.",
      "validation": {
        "required": true,
        "min_value": 1,
        "max_value": 500
      }
    },
    {
      "id": "q-siem_activo",
      "type": "boolean",
      "section": "monitorizacion",
      "label": "Teneis SIEM o plataforma de gestion centralizada de logs?",
      "tooltip": "La monitorizacion continua (op.mon.*) es obligatoria en ENS Medio y Alto.",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-backup_estrategia",
      "type": "single_select",
      "section": "continuidad",
      "label": "Como gestionais las copias de seguridad?",
      "tooltip": "La regla 3-2-1 es el minimo para ENS.",
      "options": [
        {
          "value": "cloud_automatico",
          "label": "Backup cloud automatico"
        },
        {
          "value": "software_dedicado",
          "label": "Software dedicado (Veeam, Acronis, etc.)"
        },
        {
          "value": "scripts_manuales",
          "label": "Scripts/procesos manuales"
        },
        {
          "value": "no_formal",
          "label": "No tenemos proceso formal"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-endpoints_managed",
      "type": "single_select",
      "section": "endpoints",
      "label": "Gestionais los endpoints (portatiles, moviles) de forma centralizada?",
      "tooltip": "MDM/UEM (Intune, Jamf) es la forma estandar de cumplir con op.exp.2, op.exp.3.",
      "options": [
        {
          "value": "si_mdm",
          "label": "Si, con MDM/UEM (Intune, Jamf, etc.)"
        },
        {
          "value": "solo_antivirus",
          "label": "Solo antivirus centralizado"
        },
        {
          "value": "no",
          "label": "No, son gestionados por usuarios"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-pentest_ultimo",
      "type": "single_select",
      "skip_if": {
        "question_id": "q-siem_activo",
        "operator": "equals",
        "value": false
      },
      "section": "seguridad_ofensiva",
      "label": "Cuando fue el ultimo pentest externo que hicisteis?",
      "tooltip": "ENS Medio requiere pentest externo anual (mp.s.2).",
      "options": [
        {
          "value": "ultimo_ano",
          "label": "En el ultimo ano"
        },
        {
          "value": "hace_1_3_anos",
          "label": "Hace 1-3 anos"
        },
        {
          "value": "mas_3_anos",
          "label": "Hace mas de 3 anos"
        },
        {
          "value": "nunca",
          "label": "Nunca"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-oauth_disponible",
      "type": "multi_select",
      "section": "integraciones",
      "label": "Estariais dispuestos a conectar alguna de estas plataformas via OAuth read-only?",
      "tooltip": "Los conectores OAuth permiten descubrir usuarios, MFA, activos cloud automaticamente.",
      "options": [
        {
          "value": "m365_entra",
          "label": "Microsoft 365 / Entra ID"
        },
        {
          "value": "google_workspace",
          "label": "Google Workspace"
        },
        {
          "value": "aws",
          "label": "AWS"
        },
        {
          "value": "azure",
          "label": "Azure"
        },
        {
          "value": "github",
          "label": "GitHub/GitLab"
        },
        {
          "value": "ninguno",
          "label": "Prefiero no conectar"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-observaciones_tecnicas",
      "type": "long_text",
      "section": "observaciones",
      "label": "Hay alguna particularidad tecnica importante que debamos conocer desde el arranque?",
      "tooltip": "Dependencias criticas, sistemas legacy, limitaciones, incidentes recientes.",
      "validation": {
        "required": false,
        "max_length": 5000
      }
    },
    {
      "id": "q-numero_expedientes_anio",
      "type": "number",
      "section": "contexto_sectorial",
      "label": "Numero aproximado de expedientes activos al ano",
      "validation": {
        "required": false,
        "min_value": 0
      }
    },
    {
      "id": "q-archivo_fisico",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Mantenies archivo fisico de expedientes?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-mfa_proveedores",
      "type": "boolean",
      "section": "infraestructura",
      "label": "MFA obligatorio tambien para proveedores externos con acceso?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-segregacion_red",
      "type": "single_select",
      "section": "infraestructura",
      "label": "Segregacion de red corporativa",
      "options": [
        {
          "value": "completa",
          "label": "Completa (VLANs por zona)"
        },
        {
          "value": "parcial",
          "label": "Parcial"
        },
        {
          "value": "ninguna",
          "label": "Red plana"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-cobertura_edr",
      "type": "single_select",
      "section": "infraestructura",
      "label": "Cobertura EDR/antimalware en endpoints",
      "options": [
        {
          "value": "100",
          "label": "100%"
        },
        {
          "value": "80_99",
          "label": "80-99%"
        },
        {
          "value": "menos_80",
          "label": "<80%"
        }
      ],
      "validation": {
        "required": true
      }
    }
  ]
}
