{
  "id": "onb-educacion_privada-rrhh-v1",
  "version": "1.0",
  "sector": "educacion_privada",
  "role": "rrhh",
  "nombre": "Onboarding RRHH - Educacion Privada",
  "descripcion": "Cuestionario de onboarding para el rol RRHH en una organizacion del sector Educacion Privada. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-plantilla_total",
      "type": "number",
      "section": "personas",
      "label": "Plantilla total actual",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-teletrabajo",
      "type": "single_select",
      "section": "personas",
      "label": "Porcentaje de empleados en teletrabajo",
      "options": [
        {
          "value": "0",
          "label": "0%"
        },
        {
          "value": "1_20",
          "label": "1-20%"
        },
        {
          "value": "21_50",
          "label": "21-50%"
        },
        {
          "value": "mas_50",
          "label": "Mas del 50%"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-byod",
      "type": "boolean",
      "section": "personas",
      "label": "Permitis dispositivos personales (BYOD)?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-portal_empleado",
      "type": "boolean",
      "section": "personas",
      "label": "Existe portal del empleado con datos personales online?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-formacion_ciberseguridad",
      "type": "single_select",
      "section": "personas",
      "label": "Formacion en ciberseguridad al personal",
      "options": [
        {
          "value": "anual",
          "label": "Anual obligatoria"
        },
        {
          "value": "onboarding",
          "label": "Solo en onboarding"
        },
        {
          "value": "adhoc",
          "label": "Ad-hoc cuando hay incidente"
        },
        {
          "value": "ninguna",
          "label": "Ninguna formal"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-sindicatos",
      "type": "boolean",
      "section": "personas",
      "label": "Tratais datos de afiliacion sindical (categoria especial RGPD)?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-lms",
      "type": "single_select",
      "section": "contexto_sectorial",
      "label": "Que LMS usais?",
      "options": [
        {
          "value": "moodle",
          "label": "Moodle"
        },
        {
          "value": "google_classroom",
          "label": "Google Classroom"
        },
        {
          "value": "canvas",
          "label": "Canvas"
        },
        {
          "value": "blackboard",
          "label": "Blackboard"
        },
        {
          "value": "propio",
          "label": "LMS propio"
        },
        {
          "value": "ninguno",
          "label": "Ninguno"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-datos_menores",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Tratais datos de menores de edad (LOPDGDD art. 7)?",
      "tooltip": "Los datos de menores requieren consentimiento de padres/tutores.",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-campus_virtual",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Teneis campus virtual (streaming, tutorias online)?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-sied_becas",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Gestionais SIED/becas con intercambio con AAPP?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-encuestas_clima",
      "type": "boolean",
      "section": "personas",
      "label": "Realizais encuestas de clima/satisfaccion anual?",
      "validation": {
        "required": false
      }
    }
  ]
}
