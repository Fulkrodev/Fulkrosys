{
  "id": "onb-saas_tech-compras-v1",
  "version": "1.0",
  "sector": "saas_tech",
  "role": "compras",
  "nombre": "Onboarding Compras - SaaS / Tech",
  "descripcion": "Cuestionario de onboarding para el rol Compras en una organizacion del sector SaaS / Tech. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-numero_proveedores",
      "type": "number",
      "section": "cadena_suministro",
      "label": "Numero aproximado de proveedores activos",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-criterios_seleccion_seguridad",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Incluis criterios de seguridad al seleccionar proveedores?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-clausulas_ens_rgpd",
      "type": "single_select",
      "section": "cadena_suministro",
      "label": "Contratos con clausulas ENS/RGPD (art. 28)?",
      "options": [
        {
          "value": "todos",
          "label": "Todos los proveedores TIC"
        },
        {
          "value": "criticos",
          "label": "Solo los criticos"
        },
        {
          "value": "ninguno",
          "label": "Pocos o ninguno"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-evaluacion_anual",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Evaluais anualmente a proveedores criticos?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-derecho_auditoria",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Los contratos incluyen derecho de auditoria al proveedor?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-multi_tenant",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Vuestra plataforma es multi-tenant?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-cloud_provider",
      "type": "multi_select",
      "section": "contexto_sectorial",
      "label": "En que proveedores cloud desplegais?",
      "options": [
        {
          "value": "aws",
          "label": "AWS"
        },
        {
          "value": "azure",
          "label": "Azure"
        },
        {
          "value": "gcp",
          "label": "GCP"
        },
        {
          "value": "ovh_otro",
          "label": "OVH u otro UE"
        },
        {
          "value": "on_prem",
          "label": "On-premise"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-sdlc_formal",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Teneis SDLC formalizado (SAST/DAST, revisiones)?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-clientes_publicos",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Teneis clientes del sector publico espanol?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-soc_pentest_recientes",
      "type": "single_select",
      "section": "contexto_sectorial",
      "label": "Habeis realizado pentest externo en los ultimos 12 meses?",
      "options": [
        {
          "value": "si_sin_hallazgos_criticos",
          "label": "Si, sin hallazgos criticos"
        },
        {
          "value": "si_con_hallazgos",
          "label": "Si, con hallazgos abiertos"
        },
        {
          "value": "no",
          "label": "No"
        }
      ],
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-evaluacion_inicial",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Aplicais cuestionario de seguridad al alta de proveedores?",
      "validation": {
        "required": false
      }
    }
  ]
}
