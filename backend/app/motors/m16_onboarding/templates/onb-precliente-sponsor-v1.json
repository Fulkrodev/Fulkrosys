{
  "id": "onb-precliente-sponsor-v1",
  "version": "1.0",
  "sector": "precliente",
  "role": "sponsor",
  "nombre": "Diagnóstico previo Fulkro — cuestionario del lead",
  "descripcion": "Cuestionario de diagnóstico previo que responde un lead account-less por magic-link, antes de ser cliente. Lenguaje no técnico. El formulario CAPTURA contexto; Marcos CATEGORIZA después. Ninguna pregunta revela al lead su categoría ENS.",
  "tiempo_estimado_minutos": 7,
  "language": "es",
  "questions": [
    {
      "id": "q-nombre_empresa",
      "type": "text",
      "section": "empresa",
      "label": "¿Cómo se llama tu empresa?",
      "placeholder": "Nombre o razón social",
      "validation": { "required": true, "max_length": 255 }
    },
    {
      "id": "q-cif",
      "type": "text",
      "section": "empresa",
      "label": "¿Cuál es vuestro CIF?",
      "tooltip": "Nos ayuda a identificar a la empresa de forma única. Si no lo tienes a mano, no pasa nada.",
      "placeholder": "Por ejemplo, B12345678",
      "validation": { "required": true, "max_length": 20 }
    },
    {
      "id": "q-actividad",
      "type": "long_text",
      "section": "empresa",
      "label": "¿A qué os dedicáis? Cuéntanoslo en pocas palabras",
      "placeholder": "Una o dos frases sobre vuestra actividad",
      "validation": { "required": true, "max_length": 600 }
    },
    {
      "id": "q-tamano_plantilla",
      "type": "single_select",
      "section": "empresa",
      "label": "¿Cuántas personas sois?",
      "options": [
        { "value": "1_10", "label": "Entre 1 y 10" },
        { "value": "11_50", "label": "Entre 11 y 50" },
        { "value": "51_250", "label": "Entre 51 y 250" },
        { "value": "mas_250", "label": "Más de 250" }
      ],
      "validation": { "required": true }
    },
    {
      "id": "q-relacion_aapp",
      "type": "single_select",
      "section": "sector_publico",
      "label": "¿Trabajáis con administraciones públicas?",
      "options": [
        { "value": "ya_trabajamos", "label": "Ya trabajamos con ellas" },
        { "value": "queremos_empezar", "label": "Queremos empezar" },
        { "value": "nos_lo_piden_concurso", "label": "Nos lo piden en un concurso" },
        { "value": "no_lo_tenemos_claro", "label": "No lo tenemos claro" }
      ],
      "validation": { "required": true }
    },
    {
      "id": "q-papel_aapp",
      "type": "single_select",
      "section": "sector_publico",
      "label": "¿Qué papel tenéis con esa administración?",
      "tooltip": "No te preocupes si no encaja del todo: elige lo que más se parezca.",
      "options": [
        { "value": "alojamos_tratamos_datos", "label": "Alojamos o tratamos sus datos" },
        { "value": "software_instalan_operan", "label": "Les damos un software que ellos instalan y operan" },
        { "value": "servicio_saas_gestionado", "label": "Les prestamos un servicio gestionado tipo SaaS que usan sus empleados o ciudadanos" },
        { "value": "no_lo_tengo_claro", "label": "No lo tengo claro" }
      ],
      "validation": { "required": true }
    },
    {
      "id": "q-exigido_pliego",
      "type": "single_select",
      "section": "sector_publico",
      "label": "¿Os lo han exigido en un pliego o contrato?",
      "options": [
        { "value": "si_ya_nos_lo_piden", "label": "Sí, ya nos lo piden" },
        { "value": "lo_prevemos_pronto", "label": "Lo prevemos pronto" },
        { "value": "no", "label": "No" }
      ],
      "validation": { "required": true }
    },
    {
      "id": "q-uno_o_varios",
      "type": "single_select",
      "section": "situacion_actual",
      "label": "¿Es un único producto o sistema, o tenéis varios?",
      "options": [
        { "value": "uno", "label": "Uno" },
        { "value": "varios", "label": "Varios" },
        { "value": "no_lo_se", "label": "No lo sé" }
      ],
      "validation": { "required": true }
    },
    {
      "id": "q-quien_opera",
      "type": "single_select",
      "section": "situacion_actual",
      "label": "¿Quién opera el día a día del sistema?",
      "options": [
        { "value": "nosotros", "label": "Nosotros" },
        { "value": "el_cliente", "label": "El cliente" },
        { "value": "tercero_subcontratado", "label": "Un tercero subcontratado" },
        { "value": "mixto", "label": "Mixto" }
      ],
      "validation": { "required": true }
    },
    {
      "id": "q-documentacion_previa",
      "type": "single_select",
      "section": "situacion_actual",
      "label": "¿Tenéis ya análisis de riesgos, políticas de seguridad o una Declaración de Aplicabilidad?",
      "tooltip": "Si no sabes qué es alguna de estas cosas, elige la última opción: es totalmente normal.",
      "options": [
        { "value": "si_tenemos", "label": "Sí, tenemos documentación" },
        { "value": "algo_incompleto", "label": "Algo, pero incompleto" },
        { "value": "no", "label": "No" },
        { "value": "no_se_que_es", "label": "No sé qué es eso" }
      ],
      "validation": { "required": true }
    },
    {
      "id": "q-certificaciones",
      "type": "single_select",
      "section": "situacion_actual",
      "label": "¿Tenéis alguna certificación o ya iniciasteis el ENS?",
      "options": [
        { "value": "iso_27001", "label": "ISO 27001" },
        { "value": "ya_iniciamos_ens", "label": "Ya iniciamos el ENS" },
        { "value": "otra", "label": "Otra" },
        { "value": "nada", "label": "Nada todavía" }
      ],
      "validation": { "required": true }
    },
    {
      "id": "q-nube_local",
      "type": "single_select",
      "section": "tecnologia",
      "label": "¿Vuestro producto está en la nube, instalado en local, o ambos?",
      "options": [
        { "value": "nube", "label": "En la nube" },
        { "value": "local", "label": "Instalado en local" },
        { "value": "ambos", "label": "Ambos" },
        { "value": "no_lo_se", "label": "No lo sé" }
      ],
      "validation": { "required": true }
    },
    {
      "id": "q-proveedor_nube",
      "type": "single_select",
      "section": "tecnologia",
      "label": "Si usáis la nube, ¿con qué proveedor?",
      "options": [
        { "value": "aws", "label": "AWS" },
        { "value": "azure", "label": "Azure" },
        { "value": "google_cloud", "label": "Google Cloud" },
        { "value": "ovh", "label": "OVH" },
        { "value": "otro", "label": "Otro" },
        { "value": "no_lo_se", "label": "No lo sé" }
      ],
      "validation": { "required": false },
      "skip_if": { "question_id": "q-nube_local", "operator": "equals", "value": "local" }
    },
    {
      "id": "q-datos_personales",
      "type": "single_select",
      "section": "tecnologia",
      "label": "¿Hay datos personales de ciudadanos de por medio?",
      "options": [
        { "value": "si", "label": "Sí" },
        { "value": "no", "label": "No" },
        { "value": "no_lo_se", "label": "No lo sé" }
      ],
      "validation": { "required": true },
      "internal_tag": "contexto_rgpd"
    },
    {
      "id": "q-que_os_trae",
      "type": "long_text",
      "section": "cierre",
      "label": "¿Qué os ha traído hasta aquí?",
      "placeholder": "Lo que quieras contarnos sobre tu situación",
      "validation": { "required": true, "max_length": 1000 }
    },
    {
      "id": "q-plazo",
      "type": "single_select",
      "section": "cierre",
      "label": "¿Para cuándo necesitáis tenerlo resuelto?",
      "options": [
        { "value": "urgente_concurso_fecha", "label": "Urgente, hay un concurso con fecha" },
        { "value": "en_unos_meses", "label": "En unos meses" },
        { "value": "solo_explorando", "label": "Solo estamos explorando" }
      ],
      "validation": { "required": true }
    },
    {
      "id": "q-algo_mas",
      "type": "long_text",
      "section": "cierre",
      "label": "¿Algo más que quieras contarnos?",
      "placeholder": "Opcional",
      "validation": { "required": false, "max_length": 1000 }
    }
  ]
