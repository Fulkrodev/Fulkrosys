{
  "id": "onb-sanidad_privada-operaciones-v1",
  "version": "1.0",
  "sector": "sanidad_privada",
  "role": "operaciones",
  "nombre": "Onboarding Operaciones - Sanidad Privada",
  "descripcion": "Cuestionario de onboarding para el rol Operaciones en una organizacion del sector Sanidad Privada. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-procesos_core",
      "type": "long_text",
      "section": "procesos",
      "label": "Cuales son los 3-5 procesos core del negocio?",
      "validation": {
        "required": true,
        "max_length": 2000
      }
    },
    {
      "id": "q-sla_clientes",
      "type": "boolean",
      "section": "procesos",
      "label": "Teneis SLAs comprometidos con clientes (disponibilidad, RTO)?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-continuidad_plan",
      "type": "single_select",
      "section": "procesos",
      "label": "Estado del plan de continuidad de negocio (BCP)",
      "options": [
        {
          "value": "completo_probado",
          "label": "Completo y probado"
        },
        {
          "value": "completo_no_probado",
          "label": "Completo, no probado"
        },
        {
          "value": "parcial",
          "label": "Parcial o desactualizado"
        },
        {
          "value": "no_existe",
          "label": "No existe formalmente"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-proveedores_criticos",
      "type": "number",
      "section": "procesos",
      "label": "Numero de proveedores criticos",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-kpis_operativos",
      "type": "boolean",
      "section": "procesos",
      "label": "Medis y revisais KPIs operativos periodicamente?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-his_hce",
      "type": "multi_select",
      "section": "contexto_sectorial",
      "label": "Que sistemas de historia clinica usais?",
      "options": [
        {
          "value": "his_propio",
          "label": "HIS propio"
        },
        {
          "value": "his_saas",
          "label": "HIS SaaS"
        },
        {
          "value": "hce_integrada",
          "label": "HCE integrada con AAPP"
        },
        {
          "value": "papel_mixto",
          "label": "Papel + digital"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-datos_categoria_especial",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Tratais datos de salud (categoria especial RGPD art. 9)?",
      "tooltip": "Los datos de salud requieren medidas reforzadas (mp.info.1).",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-interop_hl7_fhir",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Interoperais con otras plataformas via HL7/FHIR?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-telemedicina",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Ofreceis consultas telematicas (telemedicina)?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-consentimiento_digital",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Gestionais consentimiento informado en formato digital?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-acreditaciones_sanitarias",
      "type": "text",
      "section": "contexto_sectorial",
      "label": "Acreditaciones sanitarias en vigor (JCI, ISO 9001, etc.)",
      "validation": {
        "required": false,
        "max_length": 200
      }
    }
  ]
}
