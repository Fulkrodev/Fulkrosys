{
  "id": "onb-retail_ecommerce-operaciones-v1",
  "version": "1.0",
  "sector": "retail_ecommerce",
  "role": "operaciones",
  "nombre": "Onboarding Operaciones - Retail / Ecommerce",
  "descripcion": "Cuestionario de onboarding para el rol Operaciones en una organizacion del sector Retail / Ecommerce. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-procesos_core",
      "type": "long_text",
      "section": "procesos",
      "label": "Cuales son los 3-5 procesos core del negocio?",
      "validation": {
        "required": true,
        "max_length": 2000
      }
    },
    {
      "id": "q-sla_clientes",
      "type": "boolean",
      "section": "procesos",
      "label": "Teneis SLAs comprometidos con clientes (disponibilidad, RTO)?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-continuidad_plan",
      "type": "single_select",
      "section": "procesos",
      "label": "Estado del plan de continuidad de negocio (BCP)",
      "options": [
        {
          "value": "completo_probado",
          "label": "Completo y probado"
        },
        {
          "value": "completo_no_probado",
          "label": "Completo, no probado"
        },
        {
          "value": "parcial",
          "label": "Parcial o desactualizado"
        },
        {
          "value": "no_existe",
          "label": "No existe formalmente"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-proveedores_criticos",
      "type": "number",
      "section": "procesos",
      "label": "Numero de proveedores criticos",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-kpis_operativos",
      "type": "boolean",
      "section": "procesos",
      "label": "Medis y revisais KPIs operativos periodicamente?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-plataforma_ecommerce",
      "type": "single_select",
      "section": "contexto_sectorial",
      "label": "Que plataforma ecommerce usais?",
      "options": [
        {
          "value": "magento",
          "label": "Magento"
        },
        {
          "value": "prestashop",
          "label": "Prestashop"
        },
        {
          "value": "shopify",
          "label": "Shopify"
        },
        {
          "value": "woocommerce",
          "label": "WooCommerce"
        },
        {
          "value": "propia",
          "label": "Plataforma propia"
        },
        {
          "value": "otra",
          "label": "Otra"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-pci_dss_merchant",
      "type": "single_select",
      "section": "contexto_sectorial",
      "label": "Nivel PCI-DSS como merchant?",
      "options": [
        {
          "value": "nivel1",
          "label": "Nivel 1 (>6M transacciones)"
        },
        {
          "value": "nivel2",
          "label": "Nivel 2"
        },
        {
          "value": "nivel3",
          "label": "Nivel 3"
        },
        {
          "value": "nivel4",
          "label": "Nivel 4 (<20k)"
        },
        {
          "value": "no_aplica",
          "label": "No procesamos tarjeta directamente"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-cookies_marketing",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Usais cookies de marketing con consentimiento previo?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-incidentes_operativos_anio",
      "type": "number",
      "section": "procesos",
      "label": "Numero de incidentes operativos significativos al ano",
      "validation": {
        "required": false,
        "min_value": 0
      }
    },
    {
      "id": "q-contratos_marco",
      "type": "boolean",
      "section": "procesos",
      "label": "Existen contratos marco con clientes con clausulas de seguridad?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-numero_sedes",
      "type": "number",
      "section": "identificacion",
      "label": "Numero de sedes fisicas en Espana",
      "validation": {
        "required": false,
        "min_value": 0
      }
    }
  ]
}
