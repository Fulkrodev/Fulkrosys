      "options": [
        {
          "value": "bde",
          "label": "Banco de Espana"
        },
        {
          "value": "cnmv",
          "label": "CNMV"
        },
        {
          "value": "dgsfp",
          "label": "DGSFP"
        },
        {
          "value": "aepd",
          "label": "AEPD (solo RGPD)"
        },
        {
          "value": "ninguno",
          "label": "Ninguno especifico"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-psd2_sca",
      "type": "boolean",
      "section": "regulatorio",
      "label": "Os aplican obligaciones PSD2/SCA (autenticacion reforzada de clientes)?",
