      "label": "Teneis DPO designado formalmente?",
      "tooltip": "En fintech el DPO suele ser obligatorio por volumen de datos personales tratados.",
      "options": [
        {
          "value": "interno",
          "label": "Si, DPO interno"
        },
        {
          "value": "externo",
          "label": "Si, DPO externo"
        },
        {
          "value": "no",
          "label": "No tenemos DPO"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-regulador_supervisor",
      "type": "multi_select",
