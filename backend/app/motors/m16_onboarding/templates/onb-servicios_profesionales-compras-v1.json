    {
      "id": "q-tipo_cliente_principal",
      "type": "single_select",
      "section": "contexto_sectorial",
      "label": "Que tipo de cliente predomina?",
      "options": [
        {
          "value": "particulares",
          "label": "Particulares"
        },
        {
          "value": "empresas",
          "label": "Empresas privadas"
        },
        {
          "value": "aapp",
          "label": "Administracion Publica"
        },
        {
          "value": "mixto",
          "label": "Mixto"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-expedientes_confidenciales",
      "type": "boolean",
      "section": "contexto_sectorial",
