{
  "id": "onb-retail_ecommerce-ti_cto-v1",
  "version": "1.0",
  "sector": "retail_ecommerce",
  "role": "ti_cto",
  "nombre": "Onboarding TI / CTO - Retail / Ecommerce",
  "descripcion": "Cuestionario de onboarding para el rol TI / CTO en una organizacion del sector Retail / Ecommerce. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-numero_servidores",
      "type": "number",
      "section": "infraestructura",
      "label": "Numero aproximado de servidores (fisicos + virtuales)",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-usuarios_activos",
      "type": "number",
      "section": "infraestructura",
      "label": "Numero de usuarios activos en el sistema",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-directorio_activo",
      "type": "boolean",
      "section": "infraestructura",
      "label": "Usais Active Directory / LDAP / IdP central?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-mfa_implantado",
      "type": "single_select",
      "section": "infraestructura",
      "label": "MFA implantado?",
      "options": [
        {
          "value": "completo",
          "label": "Si, para todos"
        },
        {
          "value": "parcial",
          "label": "Solo admin/privilegiado"
        },
        {
          "value": "no",
          "label": "No implantado"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-backup_estrategia",
      "type": "single_select",
      "section": "infraestructura",
      "label": "Estrategia de backup actual",
      "options": [
        {
          "value": "3_2_1",
          "label": "Regla 3-2-1"
        },
        {
          "value": "basico",
          "label": "Backup diario basico"
        },
        {
          "value": "cloud",
          "label": "Solo cloud nativo"
        },
        {
          "value": "ninguno",
          "label": "Sin backup sistematico"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-plataforma_ecommerce",
      "type": "single_select",
      "section": "contexto_sectorial",
      "label": "Que plataforma ecommerce usais?",
      "options": [
        {
          "value": "magento",
          "label": "Magento"
        },
        {
          "value": "prestashop",
          "label": "Prestashop"
        },
        {
          "value": "shopify",
          "label": "Shopify"
        },
        {
          "value": "woocommerce",
          "label": "WooCommerce"
        },
        {
          "value": "propia",
          "label": "Plataforma propia"
        },
        {
          "value": "otra",
          "label": "Otra"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-pci_dss_merchant",
      "type": "single_select",
      "section": "contexto_sectorial",
      "label": "Nivel PCI-DSS como merchant?",
      "options": [
        {
          "value": "nivel1",
          "label": "Nivel 1 (>6M transacciones)"
        },
        {
          "value": "nivel2",
          "label": "Nivel 2"
        },
        {
          "value": "nivel3",
          "label": "Nivel 3"
        },
        {
          "value": "nivel4",
          "label": "Nivel 4 (<20k)"
        },
        {
          "value": "no_aplica",
          "label": "No procesamos tarjeta directamente"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-cookies_marketing",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Usais cookies de marketing con consentimiento previo?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-mfa_proveedores",
      "type": "boolean",
      "section": "infraestructura",
      "label": "MFA obligatorio tambien para proveedores externos con acceso?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-segregacion_red",
      "type": "single_select",
      "section": "infraestructura",
      "label": "Segregacion de red corporativa",
      "options": [
        {
          "value": "completa",
          "label": "Completa (VLANs por zona)"
        },
        {
          "value": "parcial",
          "label": "Parcial"
        },
        {
          "value": "ninguna",
          "label": "Red plana"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-cobertura_edr",
      "type": "single_select",
      "section": "infraestructura",
      "label": "Cobertura EDR/antimalware en endpoints",
      "options": [
        {
          "value": "100",
          "label": "100%"
        },
        {
          "value": "80_99",
          "label": "80-99%"
        },
        {
          "value": "menos_80",
          "label": "<80%"
        }
      ],
      "validation": {
        "required": true
      }
    }
  ]
}
