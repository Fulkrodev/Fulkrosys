        {
          "value": "nivel2",
          "label": "Nivel 2"
        },
        {
          "value": "nivel3",
          "label": "Nivel 3"
        },
        {
          "value": "nivel4",
          "label": "Nivel 4 (<20k)"
        },
        {
          "value": "no_aplica",
          "label": "No procesamos tarjeta directamente"
        }
      ],
      "validation": {
        "required": true
      }
    },
