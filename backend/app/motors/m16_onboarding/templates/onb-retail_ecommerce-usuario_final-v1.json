      "type": "single_select",
      "section": "uso_habitual",
      "label": "Con que frecuencia teletrabajas?",
      "options": [
        {
          "value": "nunca",
          "label": "Nunca"
        },
        {
          "value": "ocasional",
          "label": "Ocasional"
        },
        {
          "value": "hibrido",
          "label": "Hibrido"
        },
        {
          "value": "siempre",
          "label": "Siempre remoto"
        }
