{
  "id": "onb-retail_ecommerce-compras-v1",
  "version": "1.0",
  "sector": "retail_ecommerce",
  "role": "compras",
  "nombre": "Onboarding Compras - Retail / Ecommerce",
  "descripcion": "Cuestionario de onboarding para el rol Compras en una organizacion del sector Retail / Ecommerce. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-numero_proveedores",
      "type": "number",
      "section": "cadena_suministro",
      "label": "Numero aproximado de proveedores activos",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-criterios_seleccion_seguridad",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Incluis criterios de seguridad al seleccionar proveedores?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-clausulas_ens_rgpd",
      "type": "single_select",
      "section": "cadena_suministro",
      "label": "Contratos con clausulas ENS/RGPD (art. 28)?",
      "options": [
        {
          "value": "todos",
          "label": "Todos los proveedores TIC"
        },
        {
          "value": "criticos",
          "label": "Solo los criticos"
        },
        {
          "value": "ninguno",
          "label": "Pocos o ninguno"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-evaluacion_anual",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Evaluais anualmente a proveedores criticos?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-derecho_auditoria",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Los contratos incluyen derecho de auditoria al proveedor?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-plataforma_ecommerce",
      "type": "single_select",
      "section": "contexto_sectorial",
      "label": "Que plataforma ecommerce usais?",
      "options": [
        {
          "value": "magento",
          "label": "Magento"
        },
        {
          "value": "prestashop",
          "label": "Prestashop"
        },
        {
          "value": "shopify",
          "label": "Shopify"
        },
        {
          "value": "woocommerce",
          "label": "WooCommerce"
        },
        {
          "value": "propia",
          "label": "Plataforma propia"
        },
        {
          "value": "otra",
          "label": "Otra"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-pci_dss_merchant",
      "type": "single_select",
      "section": "contexto_sectorial",
      "label": "Nivel PCI-DSS como merchant?",
      "options": [
        {
          "value": "nivel1",
          "label": "Nivel 1 (>6M transacciones)"
        },
        {
          "value": "nivel2",
          "label": "Nivel 2"
        },
        {
          "value": "nivel3",
          "label": "Nivel 3"
        },
        {
          "value": "nivel4",
          "label": "Nivel 4 (<20k)"
        },
        {
          "value": "no_aplica",
          "label": "No procesamos tarjeta directamente"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-cookies_marketing",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Usais cookies de marketing con consentimiento previo?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-evaluacion_inicial",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Aplicais cuestionario de seguridad al alta de proveedores?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-listas_aprobados",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Existe lista corporativa de proveedores aprobados?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-numero_sedes",
      "type": "number",
      "section": "identificacion",
      "label": "Numero de sedes fisicas en Espana",
      "validation": {
        "required": false,
        "min_value": 0
      }
    }
  ]
}
