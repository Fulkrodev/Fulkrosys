{
  "id": "onb-generico-compras-v1",
  "version": "1.0",
  "sector": "generico",
  "role": "compras",
  "nombre": "Onboarding Compras - Generico",
  "descripcion": "Cuestionario de onboarding para el rol Compras en una organizacion del sector Generico. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-numero_proveedores",
      "type": "number",
      "section": "cadena_suministro",
      "label": "Numero aproximado de proveedores activos",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-criterios_seleccion_seguridad",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Incluis criterios de seguridad al seleccionar proveedores?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-clausulas_ens_rgpd",
      "type": "single_select",
      "section": "cadena_suministro",
      "label": "Contratos con clausulas ENS/RGPD (art. 28)?",
      "options": [
        {
          "value": "todos",
          "label": "Todos los proveedores TIC"
        },
        {
          "value": "criticos",
          "label": "Solo los criticos"
        },
        {
          "value": "ninguno",
          "label": "Pocos o ninguno"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-evaluacion_anual",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Evaluais anualmente a proveedores criticos?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-derecho_auditoria",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Los contratos incluyen derecho de auditoria al proveedor?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-sector_primario",
      "type": "text",
      "section": "contexto_sectorial",
      "label": "Describe brevemente el sector de actividad principal",
      "validation": {
        "required": true,
        "max_length": 200
      }
    },
    {
      "id": "q-regulacion_especifica",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Os aplica regulacion sectorial especifica distinta de RGPD/ENS?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-obligaciones_legales",
      "type": "multi_select",
      "section": "contexto_sectorial",
      "label": "Obligaciones legales conocidas que ya cumplis",
      "options": [
        {
          "value": "rgpd",
          "label": "RGPD"
        },
        {
          "value": "lopdgdd",
          "label": "LOPDGDD"
        },
        {
          "value": "lssi",
          "label": "LSSI-CE"
        },
        {
          "value": "otros",
          "label": "Otros"
        },
        {
          "value": "ninguno",
          "label": "Ninguno especifico"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-cliente_sector_publico",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Algun cliente vuestro es del sector publico?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-equipo_seguridad_dedicado",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Existe equipo o persona dedicada a seguridad de la informacion?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-evaluacion_inicial",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Aplicais cuestionario de seguridad al alta de proveedores?",
      "validation": {
        "required": false
      }
    }
  ]
}
