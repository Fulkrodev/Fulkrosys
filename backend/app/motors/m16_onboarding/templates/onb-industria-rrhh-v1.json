      "validation": {
        "required": true
      }
    },
    {
      "id": "q-pic",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Sois operador critico (Ley 8/2011 PIC) o esencial (NIS2)?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-patentes_iprop",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Tratais informacion confidencial industrial (patentes, planos)?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-sectores_clientes_publicos",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Algun cliente vuestro es Administracion Publica espanola?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-certificacion_iso",
      "type": "multi_select",
      "section": "contexto_sectorial",
      "label": "Certificaciones ISO en vigor",
      "options": [
        {
          "value": "iso_9001",
          "label": "ISO 9001"
        },
        {
          "value": "iso_14001",
          "label": "ISO 14001"
        },
        {
          "value": "iso_27001",
          "label": "ISO 27001"
        },
        {
          "value": "ninguna",
          "label": "Ninguna"
        }
      ],
      "validation": {
        "required": false
      }
    }
  ]
}
