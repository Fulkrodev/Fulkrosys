{
  "id": "onb-educacion_privada-usuario_final-v1",
  "version": "1.0",
  "sector": "educacion_privada",
  "role": "usuario_final",
  "nombre": "Onboarding Usuario Final - Educacion Privada",
  "descripcion": "Cuestionario de onboarding para el rol Usuario Final en una organizacion del sector Educacion Privada. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
