        },
        {
          "value": "canvas",
          "label": "Canvas"
        },
        {
          "value": "blackboard",
          "label": "Blackboard"
        },
        {
          "value": "propio",
          "label": "LMS propio"
        },
        {
          "value": "ninguno",
          "label": "Ninguno"
