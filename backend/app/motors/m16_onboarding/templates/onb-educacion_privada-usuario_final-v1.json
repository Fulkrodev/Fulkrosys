          "value": "nunca",
          "label": "Nunca"
        },
        {
          "value": "cifrados",
          "label": "Si, siempre cifrados"
        },
        {
          "value": "sin_cifrar",
          "label": "Si, sin cifrar"
        },
        {
          "value": "no_se",
          "label": "No lo se"
        }
