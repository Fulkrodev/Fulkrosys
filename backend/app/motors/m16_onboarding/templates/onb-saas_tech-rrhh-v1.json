{
  "id": "onb-saas_tech-rrhh-v1",
  "version": "1.0",
  "sector": "saas_tech",
  "role": "rrhh",
  "nombre": "Onboarding RRHH - SaaS / Tech",
  "descripcion": "Cuestionario de onboarding para el rol RRHH en una organizacion del sector SaaS / Tech. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-plantilla_total",
      "type": "number",
      "section": "personas",
      "label": "Plantilla total actual",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-teletrabajo",
      "type": "single_select",
      "section": "personas",
      "label": "Porcentaje de empleados en teletrabajo",
      "options": [
        {
          "value": "0",
          "label": "0%"
        },
        {
          "value": "1_20",
          "label": "1-20%"
        },
        {
          "value": "21_50",
          "label": "21-50%"
        },
        {
          "value": "mas_50",
          "label": "Mas del 50%"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-byod",
      "type": "boolean",
      "section": "personas",
      "label": "Permitis dispositivos personales (BYOD)?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-portal_empleado",
      "type": "boolean",
      "section": "personas",
      "label": "Existe portal del empleado con datos personales online?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-formacion_ciberseguridad",
      "type": "single_select",
      "section": "personas",
      "label": "Formacion en ciberseguridad al personal",
      "options": [
        {
          "value": "anual",
          "label": "Anual obligatoria"
        },
        {
          "value": "onboarding",
          "label": "Solo en onboarding"
        },
        {
          "value": "adhoc",
          "label": "Ad-hoc cuando hay incidente"
        },
        {
          "value": "ninguna",
          "label": "Ninguna formal"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-sindicatos",
      "type": "boolean",
      "section": "personas",
      "label": "Tratais datos de afiliacion sindical (categoria especial RGPD)?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-multi_tenant",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Vuestra plataforma es multi-tenant?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-cloud_provider",
      "type": "multi_select",
      "section": "contexto_sectorial",
      "label": "En que proveedores cloud desplegais?",
      "options": [
        {
          "value": "aws",
          "label": "AWS"
        },
        {
          "value": "azure",
          "label": "Azure"
        },
        {
          "value": "gcp",
          "label": "GCP"
        },
        {
          "value": "ovh_otro",
          "label": "OVH u otro UE"
        },
        {
          "value": "on_prem",
          "label": "On-premise"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-sdlc_formal",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Teneis SDLC formalizado (SAST/DAST, revisiones)?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-clientes_publicos",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Teneis clientes del sector publico espanol?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-soc_pentest_recientes",
      "type": "single_select",
      "section": "contexto_sectorial",
      "label": "Habeis realizado pentest externo en los ultimos 12 meses?",
      "options": [
        {
          "value": "si_sin_hallazgos_criticos",
          "label": "Si, sin hallazgos criticos"
        },
        {
          "value": "si_con_hallazgos",
          "label": "Si, con hallazgos abiertos"
        },
        {
          "value": "no",
          "label": "No"
        }
      ],
      "validation": {
        "required": false
      }
    }
  ]
}
