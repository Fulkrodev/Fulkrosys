{
  "id": "onb-sanidad_privada-usuario_final-v1",
  "version": "1.0",
  "sector": "sanidad_privada",
  "role": "usuario_final",
  "nombre": "Onboarding Usuario Final - Sanidad Privada",
  "descripcion": "Cuestionario de onboarding para el rol Usuario Final en una organizacion del sector Sanidad Privada. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-dispositivo_trabajo",
      "type": "single_select",
      "section": "uso_habitual",
      "label": "Que dispositivo usas para trabajar?",
      "options": [
        {
          "value": "corporativo_fijo",
          "label": "Corporativo fijo"
        },
        {
          "value": "corporativo_portatil",
          "label": "Corporativo portatil"
        },
        {
          "value": "personal_byod",
          "label": "Personal (BYOD)"
        },
        {
          "value": "mixto",
          "label": "Mixto"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-teletrabajo_frecuencia",
      "type": "single_select",
      "section": "uso_habitual",
      "label": "Con que frecuencia teletrabajas?",
      "options": [
        {
          "value": "nunca",
          "label": "Nunca"
        },
        {
          "value": "ocasional",
          "label": "Ocasional"
        },
        {
          "value": "hibrido",
          "label": "Hibrido"
        },
        {
          "value": "siempre",
          "label": "Siempre remoto"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-mfa_personal",
      "type": "boolean",
      "section": "uso_habitual",
      "label": "Usas MFA para acceder a aplicaciones de empresa?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-usb_externos",
      "type": "single_select",
      "section": "uso_habitual",
      "label": "Usas USB o discos externos para datos de empresa?",
      "options": [
        {
          "value": "nunca",
          "label": "Nunca"
        },
        {
          "value": "cifrados",
          "label": "Si, siempre cifrados"
        },
        {
          "value": "sin_cifrar",
          "label": "Si, sin cifrar"
        },
        {
          "value": "no_se",
          "label": "No lo se"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-formacion_phishing",
      "type": "boolean",
      "section": "uso_habitual",
      "label": "Has recibido formacion sobre phishing?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-incidentes_reportados",
      "type": "boolean",
      "section": "uso_habitual",
      "label": "Has reportado alguna vez un incidente/email sospechoso?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-his_hce",
      "type": "multi_select",
      "section": "contexto_sectorial",
      "label": "Que sistemas de historia clinica usais?",
      "options": [
        {
          "value": "his_propio",
          "label": "HIS propio"
        },
        {
          "value": "his_saas",
          "label": "HIS SaaS"
        },
        {
          "value": "hce_integrada",
          "label": "HCE integrada con AAPP"
        },
        {
          "value": "papel_mixto",
          "label": "Papel + digital"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-datos_categoria_especial",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Tratais datos de salud (categoria especial RGPD art. 9)?",
      "tooltip": "Los datos de salud requieren medidas reforzadas (mp.info.1).",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-interop_hl7_fhir",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Interoperais con otras plataformas via HL7/FHIR?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-telemedicina",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Ofreceis consultas telematicas (telemedicina)?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-consentimiento_digital",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Gestionais consentimiento informado en formato digital?",
      "validation": {
        "required": false
      }
    }
  ]
}
