{
  "id": "onb-logistica-legal_dpo-v1",
  "version": "1.0",
  "sector": "logistica",
  "role": "legal_dpo",
  "nombre": "Onboarding Legal / DPO - Logistica",
  "descripcion": "Cuestionario de onboarding para el rol Legal / DPO en una organizacion del sector Logistica. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-dpo_designado",
      "type": "boolean",
      "section": "compliance",
      "label": "Teneis DPO designado y registrado en AEPD?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-rat_actualizado",
      "type": "boolean",
      "section": "compliance",
      "label": "Teneis RAT (Registro de Actividades de Tratamiento) actualizado?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-eipd_realizadas",
      "type": "boolean",
      "section": "compliance",
      "label": "Habeis realizado EIPD para tratamientos de alto riesgo?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-transferencias_internacionales",
      "type": "boolean",
      "section": "compliance",
      "label": "Realizais transferencias internacionales de datos fuera UE?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-brechas_ultimo_ano",
      "type": "single_select",
      "section": "compliance",
      "label": "Brechas de seguridad/datos notificadas en el ultimo ano?",
      "options": [
        {
          "value": "ninguna",
          "label": "Ninguna"
        },
        {
          "value": "1_2",
          "label": "1-2"
        },
        {
          "value": "3_5",
          "label": "3-5"
        },
        {
          "value": "mas_5",
          "label": "Mas de 5"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-tms_wms",
      "type": "multi_select",
      "section": "contexto_sectorial",
      "label": "Que sistemas de gestion logistica usais?",
      "options": [
        {
          "value": "tms",
          "label": "TMS"
        },
        {
          "value": "wms",
          "label": "WMS"
        },
        {
          "value": "erp_logistica",
          "label": "ERP con modulo logistica"
        },
        {
          "value": "ninguno",
          "label": "Ninguno formal"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-tracking_gps",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Usais tracking GPS de flota o activos?",
      "tooltip": "El tracking genera datos de geolocalizacion sujetos a RGPD.",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-aduanas_intermodal",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Operais trafico internacional con AEAT/aduanas?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-iot_sensores",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Usais IoT (temperatura, presion, cadena de frio)?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-encargados_tratamiento",
      "type": "number",
      "section": "compliance",
      "label": "Numero aproximado de encargados de tratamiento (Art. 28)",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-derechos_arco",
      "type": "single_select",
      "section": "compliance",
      "label": "Tiempo medio de respuesta a derechos ARCO+",
      "options": [
        {
          "value": "menos_15",
          "label": "<15 dias"
        },
        {
          "value": "15_30",
          "label": "15-30 dias"
        },
        {
          "value": "mas_30",
          "label": ">30 dias"
        },
        {
          "value": "no_aplica",
          "label": "Sin solicitudes"
        }
      ],
      "validation": {
        "required": false
      }
    }
  ]
}
