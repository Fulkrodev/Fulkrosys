{
  "id": "onb-logistica-ti_cto-v1",
  "version": "1.0",
  "sector": "logistica",
  "role": "ti_cto",
  "nombre": "Onboarding TI / CTO - Logistica",
  "descripcion": "Cuestionario de onboarding para el rol TI / CTO en una organizacion del sector Logistica. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-numero_servidores",
      "type": "number",
      "section": "infraestructura",
      "label": "Numero aproximado de servidores (fisicos + virtuales)",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-usuarios_activos",
      "type": "number",
      "section": "infraestructura",
      "label": "Numero de usuarios activos en el sistema",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-directorio_activo",
      "type": "boolean",
      "section": "infraestructura",
      "label": "Usais Active Directory / LDAP / IdP central?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-mfa_implantado",
      "type": "single_select",
      "section": "infraestructura",
      "label": "MFA implantado?",
      "options": [
        {
          "value": "completo",
          "label": "Si, para todos"
        },
        {
          "value": "parcial",
          "label": "Solo admin/privilegiado"
        },
        {
          "value": "no",
          "label": "No implantado"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-backup_estrategia",
      "type": "single_select",
      "section": "infraestructura",
      "label": "Estrategia de backup actual",
      "options": [
        {
          "value": "3_2_1",
          "label": "Regla 3-2-1"
        },
        {
          "value": "basico",
          "label": "Backup diario basico"
        },
        {
          "value": "cloud",
          "label": "Solo cloud nativo"
        },
        {
          "value": "ninguno",
          "label": "Sin backup sistematico"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-tms_wms",
      "type": "multi_select",
      "section": "contexto_sectorial",
      "label": "Que sistemas de gestion logistica usais?",
      "options": [
        {
          "value": "tms",
          "label": "TMS"
        },
        {
          "value": "wms",
          "label": "WMS"
        },
        {
          "value": "erp_logistica",
          "label": "ERP con modulo logistica"
        },
        {
          "value": "ninguno",
          "label": "Ninguno formal"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-tracking_gps",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Usais tracking GPS de flota o activos?",
      "tooltip": "El tracking genera datos de geolocalizacion sujetos a RGPD.",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-aduanas_intermodal",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Operais trafico internacional con AEAT/aduanas?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-iot_sensores",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Usais IoT (temperatura, presion, cadena de frio)?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-mfa_proveedores",
      "type": "boolean",
      "section": "infraestructura",
      "label": "MFA obligatorio tambien para proveedores externos con acceso?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-segregacion_red",
      "type": "single_select",
      "section": "infraestructura",
      "label": "Segregacion de red corporativa",
      "options": [
        {
          "value": "completa",
          "label": "Completa (VLANs por zona)"
        },
        {
          "value": "parcial",
          "label": "Parcial"
        },
        {
          "value": "ninguna",
          "label": "Red plana"
        }
      ],
      "validation": {
        "required": true
      }
    }
  ]
}
