{
  "id": "onb-logistica-usuario_final-v1",
  "version": "1.0",
  "sector": "logistica",
  "role": "usuario_final",
  "nombre": "Onboarding Usuario Final - Logistica",
  "descripcion": "Cuestionario de onboarding para el rol Usuario Final en una organizacion del sector Logistica. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-dispositivo_trabajo",
      "type": "single_select",
      "section": "uso_habitual",
      "label": "Que dispositivo usas para trabajar?",
      "options": [
        {
          "value": "corporativo_fijo",
          "label": "Corporativo fijo"
        },
        {
          "value": "corporativo_portatil",
          "label": "Corporativo portatil"
        },
        {
          "value": "personal_byod",
          "label": "Personal (BYOD)"
        },
        {
          "value": "mixto",
          "label": "Mixto"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-teletrabajo_frecuencia",
      "type": "single_select",
      "section": "uso_habitual",
      "label": "Con que frecuencia teletrabajas?",
      "options": [
        {
          "value": "nunca",
          "label": "Nunca"
        },
        {
          "value": "ocasional",
          "label": "Ocasional"
        },
        {
          "value": "hibrido",
          "label": "Hibrido"
        },
        {
          "value": "siempre",
          "label": "Siempre remoto"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-mfa_personal",
      "type": "boolean",
      "section": "uso_habitual",
