      "validation": {
        "required": true
      }
    },
    {
      "id": "q-usb_externos",
      "type": "single_select",
      "section": "uso_habitual",
      "label": "Usas USB o discos externos para datos de empresa?",
      "options": [
        {
          "value": "nunca",
          "label": "Nunca"
        },
        {
          "value": "cifrados",
          "label": "Si, siempre cifrados"
        },
        {
          "value": "sin_cifrar",
          "label": "Si, sin cifrar"
        },
        {
          "value": "no_se",
          "label": "No lo se"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-formacion_phishing",
      "type": "boolean",
      "section": "uso_habitual",
      "label": "Has recibido formacion sobre phishing?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-incidentes_reportados",
      "type": "boolean",
      "section": "uso_habitual",
      "label": "Has reportado alguna vez un incidente/email sospechoso?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-tms_wms",
      "type": "multi_select",
      "section": "contexto_sectorial",
      "label": "Que sistemas de gestion logistica usais?",
      "options": [
        {
          "value": "tms",
          "label": "TMS"
        },
        {
          "value": "wms",
          "label": "WMS"
        },
        {
          "value": "erp_logistica",
          "label": "ERP con modulo logistica"
        },
        {
          "value": "ninguno",
          "label": "Ninguno formal"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-tracking_gps",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Usais tracking GPS de flota o activos?",
      "tooltip": "El tracking genera datos de geolocalizacion sujetos a RGPD.",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-aduanas_intermodal",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Operais trafico internacional con AEAT/aduanas?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-iot_sensores",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Usais IoT (temperatura, presion, cadena de frio)?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-canales_reporte",
      "type": "boolean",
      "section": "uso_habitual",
      "label": "Conoces el canal para reportar incidencias de seguridad?",
      "validation": {
        "required": true
      }
    }
  ]
}
