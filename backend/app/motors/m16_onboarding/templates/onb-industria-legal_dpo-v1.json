{
  "id": "onb-industria-legal_dpo-v1",
  "version": "1.0",
  "sector": "industria",
  "role": "legal_dpo",
  "nombre": "Onboarding Legal / DPO - Industria",
  "descripcion": "Cuestionario de onboarding para el rol Legal / DPO en una organizacion del sector Industria. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-dpo_designado",
      "type": "boolean",
      "section": "compliance",
      "label": "Teneis DPO designado y registrado en AEPD?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-rat_actualizado",
      "type": "boolean",
      "section": "compliance",
      "label": "Teneis RAT (Registro de Actividades de Tratamiento) actualizado?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-eipd_realizadas",
      "type": "boolean",
      "section": "compliance",
      "label": "Habeis realizado EIPD para tratamientos de alto riesgo?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-transferencias_internacionales",
      "type": "boolean",
      "section": "compliance",
      "label": "Realizais transferencias internacionales de datos fuera UE?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-brechas_ultimo_ano",
      "type": "single_select",
      "section": "compliance",
      "label": "Brechas de seguridad/datos notificadas en el ultimo ano?",
      "options": [
        {
          "value": "ninguna",
          "label": "Ninguna"
        },
        {
          "value": "1_2",
          "label": "1-2"
        },
        {
          "value": "3_5",
          "label": "3-5"
        },
        {
          "value": "mas_5",
          "label": "Mas de 5"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-ot_scada",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Operais sistemas OT/SCADA en planta?",
      "tooltip": "Los entornos OT tienen requisitos de segregacion con IT (mp.com).",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-pic",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Sois operador critico (Ley 8/2011 PIC) o esencial (NIS2)?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-patentes_iprop",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Tratais informacion confidencial industrial (patentes, planos)?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-sectores_clientes_publicos",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Algun cliente vuestro es Administracion Publica espanola?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-certificacion_iso",
      "type": "multi_select",
      "section": "contexto_sectorial",
      "label": "Certificaciones ISO en vigor",
      "options": [
        {
          "value": "iso_9001",
          "label": "ISO 9001"
        },
        {
          "value": "iso_14001",
          "label": "ISO 14001"
        },
        {
          "value": "iso_27001",
          "label": "ISO 27001"
        },
        {
          "value": "ninguna",
          "label": "Ninguna"
        }
      ],
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-encargados_tratamiento",
      "type": "number",
      "section": "compliance",
      "label": "Numero aproximado de encargados de tratamiento (Art. 28)",
      "validation": {
        "required": true,
        "min_value": 0
      }
    }
  ]
}
