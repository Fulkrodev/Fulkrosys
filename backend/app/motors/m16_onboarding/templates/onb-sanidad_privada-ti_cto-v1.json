{
  "id": "onb-sanidad_privada-ti_cto-v1",
  "version": "1.0",
  "sector": "sanidad_privada",
  "role": "ti_cto",
  "nombre": "Onboarding TI / CTO - Sanidad Privada",
  "descripcion": "Cuestionario de onboarding para el rol TI / CTO en una organizacion del sector Sanidad Privada. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-numero_servidores",
      "type": "number",
      "section": "infraestructura",
      "label": "Numero aproximado de servidores (fisicos + virtuales)",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-usuarios_activos",
      "type": "number",
      "section": "infraestructura",
      "label": "Numero de usuarios activos en el sistema",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-directorio_activo",
      "type": "boolean",
      "section": "infraestructura",
      "label": "Usais Active Directory / LDAP / IdP central?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-mfa_implantado",
      "type": "single_select",
      "section": "infraestructura",
      "label": "MFA implantado?",
      "options": [
        {
          "value": "completo",
          "label": "Si, para todos"
        },
        {
          "value": "parcial",
          "label": "Solo admin/privilegiado"
        },
        {
          "value": "no",
          "label": "No implantado"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-backup_estrategia",
      "type": "single_select",
      "section": "infraestructura",
      "label": "Estrategia de backup actual",
      "options": [
        {
          "value": "3_2_1",
          "label": "Regla 3-2-1"
        },
        {
          "value": "basico",
          "label": "Backup diario basico"
        },
        {
          "value": "cloud",
          "label": "Solo cloud nativo"
        },
        {
          "value": "ninguno",
          "label": "Sin backup sistematico"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-his_hce",
      "type": "multi_select",
      "section": "contexto_sectorial",
      "label": "Que sistemas de historia clinica usais?",
      "options": [
        {
          "value": "his_propio",
          "label": "HIS propio"
        },
        {
          "value": "his_saas",
          "label": "HIS SaaS"
        },
        {
          "value": "hce_integrada",
          "label": "HCE integrada con AAPP"
        },
        {
          "value": "papel_mixto",
          "label": "Papel + digital"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-datos_categoria_especial",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Tratais datos de salud (categoria especial RGPD art. 9)?",
      "tooltip": "Los datos de salud requieren medidas reforzadas (mp.info.1).",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-interop_hl7_fhir",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Interoperais con otras plataformas via HL7/FHIR?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-telemedicina",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Ofreceis consultas telematicas (telemedicina)?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-consentimiento_digital",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Gestionais consentimiento informado en formato digital?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-acreditaciones_sanitarias",
      "type": "text",
      "section": "contexto_sectorial",
      "label": "Acreditaciones sanitarias en vigor (JCI, ISO 9001, etc.)",
      "validation": {
        "required": false,
        "max_length": 200
      }
    }
  ]
}
