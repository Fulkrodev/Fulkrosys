{
  "id": "onb-generico-operaciones-v1",
  "version": "1.0",
  "sector": "generico",
  "role": "operaciones",
  "nombre": "Onboarding Operaciones - Generico",
  "descripcion": "Cuestionario de onboarding para el rol Operaciones en una organizacion del sector Generico. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-procesos_core",
      "type": "long_text",
      "section": "procesos",
      "label": "Cuales son los 3-5 procesos core del negocio?",
      "validation": {
        "required": true,
        "max_length": 2000
      }
    },
    {
      "id": "q-sla_clientes",
      "type": "boolean",
      "section": "procesos",
      "label": "Teneis SLAs comprometidos con clientes (disponibilidad, RTO)?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-continuidad_plan",
      "type": "single_select",
      "section": "procesos",
      "label": "Estado del plan de continuidad de negocio (BCP)",
      "options": [
        {
          "value": "completo_probado",
          "label": "Completo y probado"
        },
        {
          "value": "completo_no_probado",
          "label": "Completo, no probado"
        },
        {
          "value": "parcial",
          "label": "Parcial o desactualizado"
        },
        {
          "value": "no_existe",
          "label": "No existe formalmente"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-proveedores_criticos",
      "type": "number",
      "section": "procesos",
      "label": "Numero de proveedores criticos",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-kpis_operativos",
      "type": "boolean",
      "section": "procesos",
      "label": "Medis y revisais KPIs operativos periodicamente?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-sector_primario",
      "type": "text",
      "section": "contexto_sectorial",
      "label": "Describe brevemente el sector de actividad principal",
      "validation": {
        "required": true,
        "max_length": 200
      }
    },
    {
      "id": "q-regulacion_especifica",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Os aplica regulacion sectorial especifica distinta de RGPD/ENS?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-obligaciones_legales",
      "type": "multi_select",
      "section": "contexto_sectorial",
      "label": "Obligaciones legales conocidas que ya cumplis",
      "options": [
        {
          "value": "rgpd",
          "label": "RGPD"
        },
        {
          "value": "lopdgdd",
          "label": "LOPDGDD"
        },
        {
          "value": "lssi",
          "label": "LSSI-CE"
        },
        {
          "value": "otros",
          "label": "Otros"
        },
        {
          "value": "ninguno",
          "label": "Ninguno especifico"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-cliente_sector_publico",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Algun cliente vuestro es del sector publico?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-equipo_seguridad_dedicado",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Existe equipo o persona dedicada a seguridad de la informacion?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-incidentes_operativos_anio",
      "type": "number",
      "section": "procesos",
      "label": "Numero de incidentes operativos significativos al ano",
      "validation": {
        "required": false,
        "min_value": 0
      }
    }
  ]
}
