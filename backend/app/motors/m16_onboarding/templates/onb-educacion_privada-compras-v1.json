{
  "id": "onb-educacion_privada-compras-v1",
  "version": "1.0",
  "sector": "educacion_privada",
  "role": "compras",
  "nombre": "Onboarding Compras - Educacion Privada",
  "descripcion": "Cuestionario de onboarding para el rol Compras en una organizacion del sector Educacion Privada. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-numero_proveedores",
      "type": "number",
      "section": "cadena_suministro",
      "label": "Numero aproximado de proveedores activos",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-criterios_seleccion_seguridad",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Incluis criterios de seguridad al seleccionar proveedores?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-clausulas_ens_rgpd",
      "type": "single_select",
      "section": "cadena_suministro",
      "label": "Contratos con clausulas ENS/RGPD (art. 28)?",
      "options": [
        {
          "value": "todos",
          "label": "Todos los proveedores TIC"
        },
        {
          "value": "criticos",
          "label": "Solo los criticos"
        },
        {
          "value": "ninguno",
          "label": "Pocos o ninguno"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-evaluacion_anual",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Evaluais anualmente a proveedores criticos?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-derecho_auditoria",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Los contratos incluyen derecho de auditoria al proveedor?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-lms",
      "type": "single_select",
      "section": "contexto_sectorial",
      "label": "Que LMS usais?",
      "options": [
        {
          "value": "moodle",
          "label": "Moodle"
        },
        {
          "value": "google_classroom",
          "label": "Google Classroom"
        },
        {
          "value": "canvas",
          "label": "Canvas"
        },
        {
          "value": "blackboard",
          "label": "Blackboard"
        },
        {
          "value": "propio",
          "label": "LMS propio"
        },
        {
          "value": "ninguno",
          "label": "Ninguno"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-datos_menores",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Tratais datos de menores de edad (LOPDGDD art. 7)?",
      "tooltip": "Los datos de menores requieren consentimiento de padres/tutores.",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-campus_virtual",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Teneis campus virtual (streaming, tutorias online)?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-sied_becas",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Gestionais SIED/becas con intercambio con AAPP?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-evaluacion_inicial",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Aplicais cuestionario de seguridad al alta de proveedores?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-listas_aprobados",
      "type": "boolean",
      "section": "cadena_suministro",
      "label": "Existe lista corporativa de proveedores aprobados?",
      "validation": {
        "required": false
      }
    }
  ]
}
