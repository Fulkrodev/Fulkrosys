{
  "id": "onb-saas_tech-operaciones-v1",
  "version": "1.0",
  "sector": "saas_tech",
  "role": "operaciones",
  "nombre": "Onboarding Operaciones - SaaS / Tech",
  "descripcion": "Cuestionario de onboarding para el rol Operaciones en una organizacion del sector SaaS / Tech. Recoge contexto estrategico, operativo y regulatorio necesario para arrancar el proyecto ENS.",
  "tiempo_estimado_minutos": 38,
  "language": "es",
  "questions": [
    {
      "id": "q-empresa_nombre",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre comercial de la empresa",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-persona_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Nombre de la persona que cumplimenta este cuestionario",
      "validation": {
        "required": true,
        "min_length": 2,
        "max_length": 120
      }
    },
    {
      "id": "q-cargo_contacto",
      "type": "text",
      "section": "identificacion",
      "label": "Cargo de la persona de contacto",
      "validation": {
        "required": true,
        "max_length": 120
      }
    },
    {
      "id": "q-email_contacto",
      "type": "email",
      "section": "identificacion",
      "label": "Email de contacto",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-procesos_core",
      "type": "long_text",
      "section": "procesos",
      "label": "Cuales son los 3-5 procesos core del negocio?",
      "validation": {
        "required": true,
        "max_length": 2000
      }
    },
    {
      "id": "q-sla_clientes",
      "type": "boolean",
      "section": "procesos",
      "label": "Teneis SLAs comprometidos con clientes (disponibilidad, RTO)?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-continuidad_plan",
      "type": "single_select",
      "section": "procesos",
      "label": "Estado del plan de continuidad de negocio (BCP)",
      "options": [
        {
          "value": "completo_probado",
          "label": "Completo y probado"
        },
        {
          "value": "completo_no_probado",
          "label": "Completo, no probado"
        },
        {
          "value": "parcial",
          "label": "Parcial o desactualizado"
        },
        {
          "value": "no_existe",
          "label": "No existe formalmente"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-proveedores_criticos",
      "type": "number",
      "section": "procesos",
      "label": "Numero de proveedores criticos",
      "validation": {
        "required": true,
        "min_value": 0
      }
    },
    {
      "id": "q-kpis_operativos",
      "type": "boolean",
      "section": "procesos",
      "label": "Medis y revisais KPIs operativos periodicamente?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-multi_tenant",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Vuestra plataforma es multi-tenant?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-cloud_provider",
      "type": "multi_select",
      "section": "contexto_sectorial",
      "label": "En que proveedores cloud desplegais?",
      "options": [
        {
          "value": "aws",
          "label": "AWS"
        },
        {
          "value": "azure",
          "label": "Azure"
        },
        {
          "value": "gcp",
          "label": "GCP"
        },
        {
          "value": "ovh_otro",
          "label": "OVH u otro UE"
        },
        {
          "value": "on_prem",
          "label": "On-premise"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-sdlc_formal",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Teneis SDLC formalizado (SAST/DAST, revisiones)?",
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-clientes_publicos",
      "type": "boolean",
      "section": "contexto_sectorial",
      "label": "Teneis clientes del sector publico espanol?",
      "validation": {
        "required": true
      }
    },
    {
      "id": "q-soc_pentest_recientes",
      "type": "single_select",
      "section": "contexto_sectorial",
      "label": "Habeis realizado pentest externo en los ultimos 12 meses?",
      "options": [
        {
          "value": "si_sin_hallazgos_criticos",
          "label": "Si, sin hallazgos criticos"
        },
        {
          "value": "si_con_hallazgos",
          "label": "Si, con hallazgos abiertos"
        },
        {
          "value": "no",
          "label": "No"
        }
      ],
      "validation": {
        "required": false
      }
    },
    {
      "id": "q-incidentes_operativos_anio",
      "type": "number",
      "section": "procesos",
      "label": "Numero de incidentes operativos significativos al ano",
      "validation": {
        "required": false,
        "min_value": 0
      }
    }
  ]
}
