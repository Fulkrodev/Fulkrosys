    {
      "id": "q-supervisor_regulatorio",
      "type": "multi_select",
      "section": "contexto_regulatorio",
      "label": "Que supervisores regulatorios os aplican directamente?",
      "tooltip": "El supervisor regulatorio determina las normativas cruzadas con ENS. Banco de Espana y CNMV tienen requisitos de seguridad que se solapan con ENS Medio/Alto.",
      "options": [
        {
          "value": "banco_espana",
          "label": "Banco de Espana"
        },
        {
          "value": "cnmv",
          "label": "CNMV (Comision Nacional del Mercado de Valores)"
        },
        {
          "value": "bce_eba",
          "label": "BCE / EBA (entidad de credito)"
        },
        {
          "value": "dgsfp",
          "label": "DGSFP (seguros)"
        },
        {
          "value": "aepd",
          "label": "Solo AEPD (proteccion de datos)"
        },
        {
          "value": "ninguno_aun",
          "label": "Aun no tenemos supervisor asignado"
        }
      ],
      "validation": {
        "required": true
      }
    },
    {
