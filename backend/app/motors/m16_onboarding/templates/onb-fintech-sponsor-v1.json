        },
        {
          "value": "pi",
          "label": "Entidad de Pago (PI)"
        },
        {
          "value": "entidad_credito",
          "label": "Entidad de Credito (banco)"
        },
        {
          "value": "empresa_inversiones",
          "label": "Empresa de Servicios de Inversion"
        },
        {
          "value": "en_tramite",
          "label": "Licencia en tramite"
        },
        {
          "value": "no_regulado",
          "label": "No requerimos licencia regulatoria"
        }
      ],
      "validation": {
        "required": true
      }
