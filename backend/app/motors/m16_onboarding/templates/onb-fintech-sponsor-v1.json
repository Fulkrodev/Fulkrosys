  "sector": "fintech",
  "role": "sponsor",
  "nombre": "Onboarding Sponsor — Fintech",
  "descripcion": "Onboarding para el sponsor ejecutivo de una empresa fintech. Recoge contexto regulatorio, licencias, motivacion ENS, compliance previo y planificacion del proyecto.",
