name: Deploy a Hetzner (CD)

# Continuous Deployment: en cada push a main, entra por SSH al servidor de
# producción y hace pull + rebuild + recreate. Flujo: editas en local → git push
# → el servidor se actualiza solo.
#
# Requiere 3 secrets (Settings → Secrets and variables → Actions):
#   HETZNER_HOST     IP del servidor (49.13.136.91)
#   HETZNER_USER     usuario SSH (root)
#   HETZNER_SSH_KEY  clave PRIVADA ed25519 de deploy (la pública ya está en el
#                    authorized_keys del servidor). Generada como ~/.ssh/fulkro_cd.
# Si faltan, el deploy se OMITE limpio (verde) en vez de fallar.

on:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: deploy-prod
  cancel-in-progress: false

jobs:
  # §5 audit-2026-06-15 · gate previo al deploy (antes el push a main desplegaba
  # SIN ninguna verificación). Determinista y rápido (sin BD): ruff (mismas reglas
  # que CI · pin 0.15.13) + compileall (caza errores de sintaxis). El gate REAL de
  # tests sigue siendo LOCAL (`build_test_db.sh && pytest` · ver ci.yml) hasta
  # cablear la provisión completa de BD en el runner. Si el gate falla, NO se
  # despliega (deploy `needs: gate`).
  gate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Install ruff (pin)
        run: pip install ruff==0.15.13
      - name: Lint (ruff)
        run: ruff check backend/
      - name: Syntax check (compileall)
        run: python -m compileall -q backend/app

  # Gate de migraciones (ligero · SIN BD): valida la sintaxis de TODAS las
  # migraciones + que haya un ÚNICO head Alembic (el prod-breaker #1: un multi-head
  # hace fallar el `alembic upgrade head` del servicio provision en prod). La
  # validación "upgrade aplica sobre BD limpia" necesita la imagen postgres custom
  # con TODAS las extensiones (AGE/pgaudit, ausentes en pgvector/pgvector:pg16) →
  # Future-1.F.ci.full-db-provision. El health-check post-deploy ya cubre una
  # migración rota (provision la aplica en el postgres real · si falla → unhealthy).
  migrations:
    runs-on: ubuntu-latest
    env:
      DATABASE_MIGRATE_URL: postgresql://x:x@localhost:5432/x
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Build libs (cairo/pq) + backend deps
        # .[dev] arrastra pycairo (vía svglib) y psycopg2 → libs de compilación.
        run: |
          sudo apt-get update && sudo apt-get install -y build-essential pkg-config libcairo2-dev libpq-dev
          cd backend && pip install -e .[dev]
      - name: Migraciones · sintaxis + single Alembic head
        run: |
          cd backend
          python -m compileall -q migrations
          heads="$(python -m alembic heads 2>&1 || true)"
          echo "$heads"
          n="$(echo "$heads" | grep -c '(head)' || true)"
          if [ "${n:-0}" -ge 2 ]; then echo "::error::Multiple Alembic heads (${n}) · prod-breaker"; exit 1; fi
          echo "Alembic heads = ${n:-desconocido}"

  deploy:
    needs: [gate, migrations]
    runs-on: ubuntu-latest
    steps:
      - name: Deploy (pull + build + up -d) vía SSH
        env:
          HOST: ${{ secrets.HETZNER_HOST }}
          SSH_USER: ${{ secrets.HETZNER_USER }}
          KEY: ${{ secrets.HETZNER_SSH_KEY }}
        run: |
          if [ -z "$HOST" ] || [ -z "$KEY" ]; then
            echo "::notice::Secrets HETZNER_* aún no configurados — deploy OMITIDO (no es un fallo). Añádelos en Settings → Secrets → Actions y el próximo push desplegará solo."
            exit 0
          fi
          mkdir -p ~/.ssh
          printf '%s\n' "$KEY" > ~/.ssh/id_cd
          chmod 600 ~/.ssh/id_cd
          ssh-keyscan -t ed25519 "$HOST" >> ~/.ssh/known_hosts 2>/dev/null
          ssh -i ~/.ssh/id_cd -o StrictHostKeyChecking=yes "${SSH_USER:-root}@${HOST}" 'bash -s' <<'DEPLOY'
          set -euo pipefail
          cd /opt/fulkro
          echo "== git pull =="
          git pull --ff-only
          DC="docker compose -f docker-compose.prod.yml --env-file .env.prod"
          echo "== build =="
          $DC build
          echo "== up -d --remove-orphans =="
          $DC up -d --remove-orphans
          echo "== esperar healthy (real · no sleep ciego) =="
          ok=0
          for i in $(seq 1 60); do
            bad="$($DC ps -a --format '{{.Name}} {{.Health}}' 2>/dev/null | awk '$2=="unhealthy" || $2=="starting" {print $1}' | tr '\n' ' ')"
            if [ -z "$bad" ]; then ok=1; break; fi
            sleep 4
          done
          echo "== estado =="
          $DC ps --format "table {{.Service}}\t{{.Status}}"
          if [ "$ok" != "1" ]; then
            echo "::error::Servicios NO healthy tras la espera: ${bad}"
            $DC logs --tail=60 || true
            exit 1
          fi
          echo "== todos los servicios healthy =="
          DEPLOY
          echo "Deploy OK en ${HOST}"
